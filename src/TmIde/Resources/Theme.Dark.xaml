<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Tema OSCURO — se activa vía ThemeService / menú VER.
        Las claves y sus roles son idénticos en todos los temas (ver
        Theme.Light.xaml para la descripción de cada rol); solo cambian los colores.

        Marco oscuro: la barra de título, la barra de estado (WindowBackgroundBrush)
        y el explorador usan el mismo tono que los paneles flotantes
        (PanelOverlayBrush). Las franjas de los bordes y separadores, la placa del
        título y el indicador de estado usan negro con texto claro. Las pestañas
        inactivas usan el gris azulado claro #A4B1C7; la pestaña activa, la ruta
        del archivo y la figura inicial de la barra de pestañas usan #1B212A.

        DividerBrush es negro e InputBorderBrush transparente: en oscuro los
        bordes se apoyan en el contraste tonal de la rampa, no en una línea.

        AccentBrush es el rojo de la marca, igual que en el tema claro.
    -->

    <SolidColorBrush x:Key="WindowBackgroundBrush"      Color="#20262E" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush"     Color="#262D36" />
    <SolidColorBrush x:Key="PanelOverlayBrush"          Color="#20262E" />
    <SolidColorBrush x:Key="PanelHeaderBrush"           Color="#1B212A" />
    <SolidColorBrush x:Key="InputBackgroundBrush"       Color="#23282F" />
    <SolidColorBrush x:Key="DividerBrush"               Color="#000000" />
    <SolidColorBrush x:Key="SplitterBrush"               Color="#000000" />
    <SolidColorBrush x:Key="StopButtonBackgroundBrush"  Color="#1B212A" />
    <SolidColorBrush x:Key="InputBorderBrush"           Color="#00000000" />
    <SolidColorBrush x:Key="HoverBackgroundBrush"       Color="#3C4552" />
    <SolidColorBrush x:Key="ScrollbarThumbBrush"        Color="#5A6672" />
    <SolidColorBrush x:Key="AccentBrush"                Color="#BF3B2C" />
    <!-- Acento sobre las superficies de lectura: selección, subrayados y botón principal -->
    <SolidColorBrush x:Key="SurfaceAccentBrush"           Color="#BF3B2C" />
    <SolidColorBrush x:Key="SurfaceAccentForegroundBrush" Color="#FFFFFF" />
    <!-- Acento sobre las barras de la ventana: subrayado de menús, cursor, COMPILE / RUN / STOP -->
    <SolidColorBrush x:Key="ChromeAccentBrush"           Color="#BF3B2C" />
    <SolidColorBrush x:Key="ChromeAccentForegroundBrush" Color="#000000" />
    <!-- Encabezado, pie y recuadro de código de la ventana de ayuda -->
    <SolidColorBrush x:Key="ReferencePanelBackgroundBrush" Color="#20262E" />
    <SolidColorBrush x:Key="PrimaryForegroundBrush"     Color="#E7EBEF" />
    <SolidColorBrush x:Key="SecondaryForegroundBrush"   Color="#A8B3BF" />
    <SolidColorBrush x:Key="TertiaryForegroundBrush"    Color="#6F7B87" />
    <SolidColorBrush x:Key="CloseButtonHoverBrush"      Color="#E81123" />
    <SolidColorBrush x:Key="TitleMenuForegroundBrush"   Color="#A0B2D6" />
    <SolidColorBrush x:Key="ChromeShapeBrush"           Color="#3A4452" />
    <SolidColorBrush x:Key="ChromeShapeHoverBrush"      Color="#4A5566" />
    <!-- Figura decorativa que cierra el grupo COMPILE / RUN / STOP -->
    <SolidColorBrush x:Key="StatusActionsTailBrush"     Color="#BF3B2C" />

    <!-- Explorador de archivos: cuerpo del árbol y texto de sus entradas -->
    <SolidColorBrush x:Key="ExplorerBackgroundBrush"         Color="#20262E" />
    <SolidColorBrush x:Key="ExplorerItemForegroundBrush"     Color="#E6EEF8" />
    <SolidColorBrush x:Key="ExplorerMainFileForegroundBrush" Color="#8ED8FF" />

    <!-- Pestañas del editor: la activa toma el tono del editor, las demás el claro -->
    <SolidColorBrush x:Key="ActiveTabBackgroundBrush"        Color="#1B212A" />
    <SolidColorBrush x:Key="ActiveTabForegroundBrush"        Color="#E7EBEF" />
    <SolidColorBrush x:Key="ActiveTabCloseIconBrush"         Color="#A8B3BF" />
    <SolidColorBrush x:Key="InactiveTabBackgroundBrush"      Color="#A4B1C7" />
    <SolidColorBrush x:Key="InactiveTabHoverBackgroundBrush" Color="#B8C3D6" />
    <SolidColorBrush x:Key="InactiveTabForegroundBrush"      Color="#23303A" />
    <SolidColorBrush x:Key="InactiveTabCloseIconBrush"       Color="#23303A" />

    <!-- Figura decorativa al inicio de la barra de pestañas -->
    <SolidColorBrush x:Key="TabStripLeadBrush"     Color="#1B212A" />

    <!-- Divisor entre el explorador y el editor (separador y borde del explorador) -->
    <SolidColorBrush x:Key="ExplorerSplitterBrush" Color="#000000" />

    <!-- Ruta del archivo, bajo las pestañas -->
    <SolidColorBrush x:Key="DocumentPathBackgroundBrush"   Color="#1B212A" />
    <SolidColorBrush x:Key="DocumentPathForegroundBrush"   Color="#A8B3BF" />
    <SolidColorBrush x:Key="DocumentPathSeparatorBrush"    Color="#6F7B87" />

    <!-- Franjas horizontales de la ventana: bordes, separadores y placa del título -->
    <SolidColorBrush x:Key="WindowBandBrush"       Color="#000000" />
    <SolidColorBrush x:Key="TitlePlateForegroundBrush" Color="#A4B1C7" />

    <!-- Indicador de estado del proyecto, al centro de la barra de estado -->
    <SolidColorBrush x:Key="StatusIndicatorBackgroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="StatusIndicatorForegroundBrush" Color="#D5D5D5" />

    <!-- Colores de sintaxis del editor (sobre SurfaceBackgroundBrush) -->
    <SolidColorBrush x:Key="SyntaxKeywordBrush"         Color="#E0604F" />
    <SolidColorBrush x:Key="SyntaxTypeBrush"            Color="#6CB6E8" />
    <SolidColorBrush x:Key="SyntaxLiteralBrush"         Color="#C792EA" />
    <SolidColorBrush x:Key="SyntaxNumberBrush"          Color="#7FD1B0" />
    <SolidColorBrush x:Key="SyntaxStringBrush"          Color="#E5C07B" />
    <SolidColorBrush x:Key="SyntaxCommentBrush"         Color="#6F7B87" />

    <!-- Subrayado de diagnósticos del editor -->
    <SolidColorBrush x:Key="DiagnosticErrorBrush"       Color="#FF6B5E" />
    <SolidColorBrush x:Key="DiagnosticWarningBrush"     Color="#E5B04A" />

    <!-- Pantalla de inicio: fondo central, rótulos de sección y mensaje de error -->
    <SolidColorBrush x:Key="StartCentralBrush"          Color="#1B212A" />
    <SolidColorBrush x:Key="StartBarBrush"              Color="#12161C" />
    <SolidColorBrush x:Key="StartFrameBrush"            Color="#12161C" />
    <SolidColorBrush x:Key="StartCaptionBrush"          Color="#8C99AD" />
    <SolidColorBrush x:Key="StartErrorBrush"            Color="#E0604F" />
    <SolidColorBrush x:Key="StartTextStrongBrush"       Color="#FFFFFF" />
    <SolidColorBrush x:Key="StartTextBrush"             Color="#B6C1D3" />
    <SolidColorBrush x:Key="StartTextMutedBrush"        Color="#6F7B87" />
    <SolidColorBrush x:Key="StartTextDimBrush"          Color="#8C99AD" />
    <SolidColorBrush x:Key="StartVeilHoverBrush"        Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="StartVeilSelectedBrush"     Color="#14FFFFFF" />
    <SolidColorBrush x:Key="StartAccentTextBrush"       Color="#E0604F" />

</ResourceDictionary>
