<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:search="clr-namespace:ICSharpCode.AvalonEdit.Search;assembly=ICSharpCode.AvalonEdit"
                    xmlns:completion="clr-namespace:ICSharpCode.AvalonEdit.CodeCompletion;assembly=ICSharpCode.AvalonEdit"
                    xmlns:completionModel="clr-namespace:TmIde.Services.Completion"
                    xmlns:completionView="clr-namespace:TmIde.Controls.Completion"
                    xmlns:searchReplace="clr-namespace:TmIde.Controls.Search">

    <!--
        Estilos compartidos: se mergean en App.xaml para que todas las ventanas
        los vean. Patrón por control: un Border "Chrome" + ContentPresenter y
        triggers que intercambian Background con HoverBackgroundBrush /
        AccentBrush. Los colores salen de {DynamicResource} y cambian con el tema,
        salvo la paleta teal de los botones de la barra de estado.
        Esquinas rectas en toda la UI (sin CornerRadius).
    -->

    <!-- Recursos base -->

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Paleta de los paneles flotantes (búsqueda, desplegables, autocompletado):
        son oscuros en ambos temas, así que su texto usa tonos claros fijos. -->
    <SolidColorBrush x:Key="OverlayTextBrush"          Color="#E7EBEF" />
    <SolidColorBrush x:Key="OverlaySecondaryTextBrush" Color="#A8B3BF" />
    <SolidColorBrush x:Key="OverlayMutedTextBrush"     Color="#6F7B87" />
    <SolidColorBrush x:Key="OverlayRuleBrush"          Color="#3A4452" />
    <SolidColorBrush x:Key="OverlayShadowBrush"        Color="#12161C" />
    <SolidColorBrush x:Key="OverlayEdgeBrush"          Color="#0B0E12" />

    <!-- Tipografía única: IBM Plex Mono (src/Assets). La ruta "../Assets/" es relativa
        a este archivo (Resources/); con "./Assets/" WPF no encontraba las fuentes y
        caía a Consolas. Consolas y Courier New solo son respaldo. -->
    <FontFamily x:Key="CodeFontFamily">../Assets/#IBM Plex Mono, Consolas, Courier New</FontFamily>

    <!-- Interfaz general: la misma familia, aplicada en los estilos base -->
    <FontFamily x:Key="UiFontFamily">../Assets/#IBM Plex Mono, Consolas, Courier New</FontFamily>

    <!-- Cabeceras: la misma familia -->
    <FontFamily x:Key="HeaderFontFamily">../Assets/#IBM Plex Mono, Consolas, Courier New</FontFamily>

    <sys:Double x:Key="CodeFontSize">13</sys:Double>

    <!-- Escala tipográfica común: todo FontSize de la UI sale de estos roles. -->
    <sys:Double x:Key="FontSizeCaption">10</sys:Double>
    <sys:Double x:Key="FontSizeSmall">11</sys:Double>
    <sys:Double x:Key="FontSizeBody">12</sys:Double>
    <sys:Double x:Key="FontSizeEmphasis">13</sys:Double>
    <sys:Double x:Key="FontSizeTitle">15</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">18</sys:Double>

    <!-- TextBlock -->

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="SectionHeaderText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Button -->

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón de barra de estado (COMPILE / RUN / STOP): paralelogramo oscuro
        (#1B212A) con texto blanco. La forma es un Path con Stretch=Fill, así
        que se adapta al Width/Height del botón manteniendo la inclinación.
        Hover/pressed se pintan con una capa superpuesta de la misma forma. -->
    <Style x:Key="StatusActionButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource ChromeShapeBrush}" />
        <!-- Sin borde por defecto: el gris del sistema asomaría por el trazo de la plantilla. -->
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Width" Value="104" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Path Stretch="Fill" Fill="{TemplateBinding Background}"
                                Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"
                                Data="M0,0 L174,0 L180,32 L6,32 Z" />
                        <Path x:Name="Overlay" Stretch="Fill" Fill="Transparent"
                                Data="M0,0 L174,0 L180,32 L6,32 Z" />
                        <!-- TextBlock explícito con Foreground local: un ContentPresenter
                            generaría el TextBlock con el estilo implícito global
                            (PrimaryForegroundBrush) y el texto no saldría blanco. -->
                        <TextBlock Text="{TemplateBinding Content}"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Fill" Value="#1FFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Fill" Value="#33000000" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- COMPILE y RUN: fondo con el acento de las barras y su color de texto. -->
    <Style x:Key="StatusPrimaryActionButton" TargetType="Button"
            BasedOn="{StaticResource StatusActionButton}">
        <Setter Property="Background" Value="{DynamicResource ChromeAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ChromeAccentForegroundBrush}" />
    </Style>

    <!-- STOP: fondo de la barra con borde y texto del acento de las barras. -->
    <Style x:Key="StatusStopActionButton" TargetType="Button"
            BasedOn="{StaticResource StatusActionButton}">
        <Setter Property="BorderBrush" Value="{DynamicResource ChromeAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ChromeAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource StopButtonBackgroundBrush}" />
    </Style>

    <!-- Botón de caption (min/max/close): aspecto 1:1, sin esquinas redondeadas -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CloseButtonHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox -->

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollBar -->

    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource ScrollbarThumbBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb}" Margin="2,0" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="Root" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GridSplitter -->

    <!-- La línea ocupa todo el splitter, sin márgenes ni relleno: su grosor es
        el Width/Height que fije cada GridSplitter. Su color sale de SplitterBrush;
        en hover pasa al rojo de acento. -->
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource SplitterBrush}" />
        <Setter Property="ShowsPreview" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Rectangle Fill="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#BF3B2C" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ToolTip y ContextMenu toman la fuente del sistema en vez de heredarla: se fija aquí. -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
    </Style>

    <!-- TreeView -->

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style x:Key="TreeExpandToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <Path x:Name="Arrow"
                                Data="{StaticResource IconChevron}"
                                Fill="{DynamicResource PrimaryForegroundBrush}"
                                Width="9" Height="9" Stretch="Uniform"
                                RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="Chrome" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="Expander"
                                                Grid.Column="0"
                                                Style="{StaticResource TreeExpandToggle}"
                                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                ClickMode="Press" />
                                <ContentPresenter x:Name="PART_Header"
                                                    Grid.Column="1"
                                                    ContentSource="Header"
                                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost" Margin="12,0,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TabControl / TabItem -->

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel x:Name="HeaderPanel" Grid.Row="0" Panel.ZIndex="1" IsItemsHost="True" />
                        <Border Grid.Row="1" Background="Transparent">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu / MenuItem -->

    <Style TargetType="Menu">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Header" VerticalAlignment="Center" />
                            <Popup x:Name="PART_Popup"
                                    Placement="Bottom"
                                    IsOpen="{TemplateBinding IsSubmenuOpen}"
                                    AllowsTransparency="True"
                                    Focusable="False"
                                    PopupAnimation="Fade">
                                <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                        Padding="4"
                                        SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Panel de búsqueda del editor (Ctrl+F, AvalonEdit). Se reemplaza su plantilla
        por defecto (fondo blanco, iconos de imagen) por una oscura como el
        explorador, con los controles propios de la UI. Debe vivir a nivel de
        aplicación: el panel se muestra en la capa de adorno de la ventana, fuera
        del árbol del UserControl del editor. -->

    <Style x:Key="SearchIconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource OverlayTextBrush}" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeEmphasis}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="Transparent">
                        <!-- TextBlock explícito con Foreground local: un ContentPresenter generaría el
                            TextBlock con el estilo implícito global (color oscuro) -->
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#3C4552" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SearchToggleButton" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource OverlayTextBrush}" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" Background="Transparent">
                        <!-- TextBlock explícito con Foreground local: un ContentPresenter generaría el
                            TextBlock con el estilo implícito global (color oscuro) -->
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#3C4552" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="search:SearchPanel">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="search:SearchPanel">
                    <Border Background="{DynamicResource PanelOverlayBrush}"
                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,4,22,0" Padding="4" Cursor="Arrow">
                        <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <!-- Muestra u oculta la fila de reemplazo (Ctrl+H la abre) -->
                            <ToggleButton Style="{StaticResource SearchToggleButton}" Margin="0,0,4,0" Content="⇄"
                                          FontSize="{DynamicResource FontSizeSmall}" ToolTip="Reemplazar (Ctrl+H)"
                                          IsChecked="{Binding (searchReplace:SearchPanelReplace.IsReplaceVisible), RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <TextBox x:Name="PART_searchTextBox" Width="190" Height="24" Focusable="True"
                                     Padding="6,0" VerticalContentAlignment="Center"
                                     Background="{DynamicResource InputBackgroundBrush}"
                                     Foreground="{StaticResource OverlayTextBrush}" CaretBrush="{StaticResource OverlayTextBrush}"
                                     FontFamily="{DynamicResource CodeFontFamily}" FontSize="{DynamicResource FontSizeBody}"
                                     Text="{Binding SearchPattern, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                            <ToggleButton Style="{StaticResource SearchToggleButton}" Margin="4,0,0,0" Content="Aa"
                                          FontSize="{DynamicResource FontSizeSmall}" ToolTip="{Binding Localization.MatchCaseText, RelativeSource={RelativeSource TemplatedParent}}"
                                          IsChecked="{Binding MatchCase, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <ToggleButton Style="{StaticResource SearchToggleButton}" Content="W"
                                          FontSize="{DynamicResource FontSizeSmall}" ToolTip="{Binding Localization.MatchWholeWordsText, RelativeSource={RelativeSource TemplatedParent}}"
                                          IsChecked="{Binding WholeWords, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <ToggleButton Style="{StaticResource SearchToggleButton}" Content=".*"
                                          FontSize="{DynamicResource FontSizeSmall}" ToolTip="{Binding Localization.UseRegexText, RelativeSource={RelativeSource TemplatedParent}}"
                                          IsChecked="{Binding UseRegex, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <Button Style="{StaticResource SearchIconButton}" Margin="4,0,0,0" Content="↑"
                                    Command="search:SearchCommands.FindPrevious"
                                    ToolTip="{Binding Localization.FindPreviousText, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Button Style="{StaticResource SearchIconButton}" Content="↓"
                                    Command="search:SearchCommands.FindNext"
                                    ToolTip="{Binding Localization.FindNextText, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Button Style="{StaticResource SearchIconButton}" Content="✕"
                                    Command="search:SearchCommands.CloseSearchPanel" />
                        </StackPanel>

                        <!-- Fila de reemplazo: actúa solo sobre el documento visible y no guarda -->
                        <StackPanel Orientation="Horizontal" Margin="28,4,0,0"
                                    Visibility="{Binding (searchReplace:SearchPanelReplace.IsReplaceVisible), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibility}}">
                            <TextBox Width="190" Height="24" Padding="6,0" VerticalContentAlignment="Center"
                                     Background="{DynamicResource InputBackgroundBrush}"
                                     Foreground="{StaticResource OverlayTextBrush}" CaretBrush="{StaticResource OverlayTextBrush}"
                                     FontFamily="{DynamicResource CodeFontFamily}" FontSize="{DynamicResource FontSizeBody}"
                                     ToolTip="Reemplazar por (admite $1 con expresión regular)"
                                     Text="{Binding (searchReplace:SearchPanelReplace.ReplacementText), RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="searchReplace:SearchPanelReplace.ReplaceNext" />
                                    <KeyBinding Key="Enter" Modifiers="Control+Alt" Command="searchReplace:SearchPanelReplace.ReplaceAll" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Style="{StaticResource SearchIconButton}" Margin="4,0,0,0" Content="↵"
                                    Command="searchReplace:SearchPanelReplace.ReplaceNext"
                                    ToolTip="Reemplazar (Enter)" />
                            <Button Style="{StaticResource SearchIconButton}" Content="⇊"
                                    Command="searchReplace:SearchPanelReplace.ReplaceAll"
                                    ToolTip="Reemplazar todo (Ctrl+Alt+Enter)" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis"
                                       FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Text="{Binding (searchReplace:SearchPanelReplace.Status), RelativeSource={RelativeSource TemplatedParent}}" />
                        </StackPanel>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--
        Autocompletado del editor (Ctrl+Espacio, AvalonEdit). La lista se abre en su
        propia ventana, fuera del árbol del editor, por eso sus estilos viven a nivel
        de aplicación. Comparte el lenguaje visual del desplegable de la barra de
        título: franja de acento y filas con marcador. La ficha al pie explica la
        sugerencia seleccionada.
    -->

    <!-- Ventana transparente (EditorCompletionController): el contenedor dibuja
        su propio marco recto y su sombra. -->
    <Style TargetType="completion:CompletionWindow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource CodeFontFamily}" />
    </Style>

    <!-- Fila: marcador | contenido (CompletionSuggestion). Seleccionada: el marcador
        crece y la fila se tiñe del acento; con el mouse encima, un tinte más leve. -->
    <Style x:Key="CompletionRow" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Height="26" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle x:Name="Wash" Grid.ColumnSpan="2" Fill="{DynamicResource AccentBrush}" Opacity="0" />
                        <Rectangle Grid.Column="0" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="MarkerScale" ScaleX="1" ScaleY="0" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <ContentPresenter Grid.Column="1" Margin="8,0,10,0" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Wash" Property="Opacity" Value="0.07" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Wash" Property="Opacity" Value="0.18" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MarkerScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MarkerScale" Storyboard.TargetProperty="ScaleY"
                                                         To="0" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="completion:CompletionListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- Contenedor de la lista: plantilla propia con filas y ficha.
        PART_ListBox es el nombre que AvalonEdit espera. -->
    <Style TargetType="completion:CompletionList">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="completion:CompletionList">
                    <Grid Margin="0,0,12,12" SnapsToDevicePixels="True">
                        <!-- Sombra en capa propia: no desenfoca el texto -->
                        <Border Background="{StaticResource OverlayShadowBrush}">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="5" Direction="290" Opacity="0.55" />
                            </Border.Effect>
                        </Border>

                        <Border Background="{DynamicResource PanelOverlayBrush}" BorderBrush="{StaticResource OverlayEdgeBrush}" BorderThickness="1,0,1,1">
                            <DockPanel>
                                <Rectangle DockPanel.Dock="Top" Height="2" Fill="{DynamicResource AccentBrush}" />

                                <!-- Ficha de la sugerencia seleccionada -->
                                <StackPanel DockPanel.Dock="Bottom">
                                    <Rectangle Height="1" Margin="10,2,10,0" Stroke="{StaticResource OverlayRuleBrush}" StrokeDashArray="2 3" StrokeThickness="1" />
                                    <ContentPresenter Margin="10,6,10,8"
                                                      Content="{Binding SelectedItem.Details, ElementName=PART_ListBox}" />
                                </StackPanel>

                                <completion:CompletionListBox x:Name="PART_ListBox" MaxHeight="208"
                                                              ItemContainerStyle="{StaticResource CompletionRow}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding Content}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </completion:CompletionListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Contenido de la fila: insignia de la clase (letra y color de sintaxis), etiqueta y detalle -->
    <DataTemplate DataType="{x:Type completionModel:CompletionSuggestion}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="Badge" Grid.Column="0" FontWeight="Bold" FontSize="{DynamicResource FontSizeSmall}"
                       FontFamily="{DynamicResource CodeFontFamily}"
                       VerticalAlignment="Center" Text="k" Foreground="#E0604F" />
            <TextBlock Grid.Column="1" Text="{Binding Label}" FontFamily="{DynamicResource CodeFontFamily}"
                       FontSize="{DynamicResource CodeFontSize}" Foreground="{StaticResource OverlayTextBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Text="{Binding Detail}" Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="150"
                       TextTrimming="CharacterEllipsis"
                       FontFamily="{DynamicResource CodeFontFamily}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource OverlayMutedTextBrush}" />
        </Grid>

        <!-- Letra y color de la insignia por clase de sugerencia (paleta oscura de sintaxis) -->
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Snippet">
                <Setter TargetName="Badge" Property="Text" Value="▸" />
                <Setter TargetName="Badge" Property="Foreground" Value="#E5C07B" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Type">
                <Setter TargetName="Badge" Property="Text" Value="T" />
                <Setter TargetName="Badge" Property="Foreground" Value="#6CB6E8" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Literal">
                <Setter TargetName="Badge" Property="Text" Value="L" />
                <Setter TargetName="Badge" Property="Foreground" Value="#C792EA" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Function">
                <Setter TargetName="Badge" Property="Text" Value="ƒ" />
                <Setter TargetName="Badge" Property="Foreground" Value="#7FD1B0" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Variable">
                <Setter TargetName="Badge" Property="Text" Value="v" />
                <Setter TargetName="Badge" Property="Foreground" Value="{StaticResource OverlayTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Parameter">
                <Setter TargetName="Badge" Property="Text" Value="p" />
                <Setter TargetName="Badge" Property="Foreground" Value="{StaticResource OverlaySecondaryTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Constant">
                <Setter TargetName="Badge" Property="Text" Value="c" />
                <Setter TargetName="Badge" Property="Foreground" Value="#C792EA" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Word">
                <Setter TargetName="Badge" Property="Text" Value="a" />
                <Setter TargetName="Badge" Property="Foreground" Value="{StaticResource OverlayMutedTextBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Ficha al pie: nombre y detalle en una línea, explicación debajo -->
    <DataTemplate DataType="{x:Type completionView:CompletionDescription}">
        <StackPanel>
            <TextBlock TextWrapping="Wrap" FontFamily="{DynamicResource CodeFontFamily}">
                <Run Text="{Binding Title, Mode=OneWay}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="#6CB6E8" />
                <Run Text="  " />
                <Run Text="{Binding Detail, Mode=OneWay}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource OverlaySecondaryTextBrush}" />
            </TextBlock>
            <TextBlock Text="{Binding Text}" Margin="0,4,0,0" TextWrapping="Wrap"
                       FontFamily="{DynamicResource CodeFontFamily}" FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="#C7CBD2" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
