<UserControl x:Class="TmIde.Controls.LineNumberedTextBox"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
            mc:Ignorable="d"
            d:DesignHeight="240" d:DesignWidth="480"
            Background="{DynamicResource SurfaceBackgroundBrush}">

    <!--
        Editor de código basado en AvalonEdit: números de línea propios, scroll
        y coloreado de sintaxis TM (ver Controls/Syntax). Colores de fondo, texto
        y números de línea enlazados al tema; selección y cursor se aplican en el
        code-behind (no son propiedades de dependencia).
    -->
    <ae:TextEditor x:Name="Editor"
                    ShowLineNumbers="True"
                    WordWrap="False"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    Background="{DynamicResource SurfaceBackgroundBrush}"
                    Foreground="{DynamicResource PrimaryForegroundBrush}"
                    LineNumbersForeground="{DynamicResource TertiaryForegroundBrush}"
                    FontFamily="{DynamicResource CodeFontFamily}"
                    FontSize="{DynamicResource CodeFontSize}"
                    Padding="8,8,8,8" />
</UserControl>
