<UserControl x:Class="TmIde.Controls.Particles.ParticlePanel"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:design="clr-namespace:TmIde.Design"
            mc:Ignorable="d"
            d:DataContext="{x:Static design:DesignData.ParticlePanel}"
            d:DesignWidth="260" d:DesignHeight="160">

    <!-- Panel de partículas : solo la nube; su forma y su color dicen el
        estado del proyecto, sin texto. -->
    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0">
        <!-- Escenario: la misma superficie que el editor y Output, así que sigue al
            tema. El lienzo copia este fondo en cada fotograma; su tamaño decide
            el del mapa de bits. -->
        <Grid x:Name="Stage" Background="{DynamicResource SurfaceBackgroundBrush}" ClipToBounds="True">
            <Image x:Name="DotLayer" Stretch="Fill" IsHitTestVisible="False" />
        </Grid>
    </Border>
</UserControl>
