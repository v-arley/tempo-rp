<UserControl x:Class="TmIde.Controls.LogView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
            Background="{DynamicResource SurfaceBackgroundBrush}">

    <!--
        Visor de log de solo lectura sobre AvalonEdit: virtualiza el pintado (un
        ItemsControl crea un elemento visual por línea) y permite seleccionar y
        copiar texto de varias líneas.
    -->
    <ae:TextEditor x:Name="Editor"
                    IsReadOnly="True"
                    ShowLineNumbers="False"
                    WordWrap="False"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    Background="{DynamicResource SurfaceBackgroundBrush}"
                    Foreground="{DynamicResource SecondaryForegroundBrush}"
                    FontFamily="{DynamicResource CodeFontFamily}"
                    FontSize="{DynamicResource CodeFontSize}"
                    Padding="10,8" />
</UserControl>
