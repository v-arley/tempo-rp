<UserControl x:Class="TmIde.Views.StatusBarView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:design="clr-namespace:TmIde.Design"
            xmlns:vm="clr-namespace:TmIde.ViewModels"
            mc:Ignorable="d"
            d:DataContext="{x:Static design:DesignData.StatusBar}"
            d:DesignWidth="900"
            Height="34">

    <!-- Footer: misma distribución que el header, reflejada. Contenedor principal
            a todo el ancho con dos hijos en columna.
            Fila 0: barra en tres secciones de igual ancho
                    (indicadores | reservado | acciones).
            Fila 1: franja del borde inferior, de 6px.
            Sin Border: los fondos van en Grid. -->
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="6" />
        </Grid.RowDefinitions>

        <!-- Hijo superior: izquierda / centro / derecha, un tercio cada una -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Izquierda: posición del cursor y codificación del documento activo -->
            <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="11,0,0,0"
                        FontFamily="{DynamicResource CodeFontFamily}" FontWeight="Medium" FontSize="{DynamicResource FontSizeSmall}"
                        Foreground="{DynamicResource ChromeAccentBrush}">
                <Run Text="{Binding CaretPosition, Mode=OneWay}" />
                <Run Text="   " />
                <Run Text="{Binding Encoding, Mode=OneWay}" />
                <Run Text="   " />
                <Run Text="{Binding ProblemsSummary, Mode=OneWay}" />
            </TextBlock>

            
            <!-- Centro: indicador del estado del proyecto -->
            <Grid Grid.Column="1">

                <!-- Trapecio de fondo del indicador -->
                <Path
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Width="212"
                    Height="22"
                    IsHitTestVisible="False"
                    Stretch="Fill"
                    Fill="{DynamicResource StatusIndicatorBackgroundBrush}"
                    Data="M14,0 L198,0 L212,22 L0,22 Z" />

                <!-- Estado de compilación y ejecución -->
                <TextBlock
                    Text="{Binding ProjectStatusText}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource CodeFontFamily}"
                    FontWeight="SemiBold"
                    FontSize="{DynamicResource FontSizeSmall}"
                    Foreground="{DynamicResource StatusIndicatorForegroundBrush}">

                </TextBlock>

            </Grid>


            <!-- Derecha: acciones del proyecto (STOP solo activo durante RUN). Botones
                de 16 en una barra de 28: 6px arriba y abajo. Cierra el grupo una figura
                con la misma forma pero con el lateral derecho recto, pegada al borde. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <Button Style="{StaticResource StatusPrimaryActionButton}" Content="COMPILE"
                        Command="{Binding Commands.Compile}" />
                <Button Style="{StaticResource StatusPrimaryActionButton}" Content="RUN"
                        Command="{Binding Commands.Run}" />
                <Button Style="{StaticResource StatusStopActionButton}" Content="STOP"
                        Command="{Binding Commands.Stop}" />
                <!-- 22x16 (25% del ancho de un botón). Geometría a tamaño real, sin
                    Stretch, para conservar la inclinación de 3px de los botones. -->
                <Path Width="22" Height="16" Margin="8,0,0,0" IsHitTestVisible="False"
                        Fill="{DynamicResource ChromeShapeBrush}"
                        Data="M0,0 L22,0 L22,16 L3,16 Z" />
            </StackPanel>
        </Grid>

        <!-- Hijo inferior: franja del borde inferior -->
        <Grid Grid.Row="1" Background="{DynamicResource WindowBandBrush}" />
    </Grid>
</UserControl>
