<UserControl x:Class="TmIde.Views.StatusBarView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:design="clr-namespace:TmIde.Design"
            xmlns:vm="clr-namespace:TmIde.ViewModels"
            xmlns:controls="clr-namespace:TmIde.Controls"
            mc:Ignorable="d"
            d:DataContext="{x:Static design:DesignData.StatusBar}"
            d:DesignWidth="900"
            Height="40">

    <!-- Footer: misma distribución que el header, reflejada. Contenedor principal
            a todo el ancho con dos hijos en columna.
            Fila 0: barra en tres secciones de igual ancho
                    (indicadores | reservado | acciones).
            Fila 1: franja del borde inferior, de 6px.
            Sin Border: los fondos van en Grid. -->
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="6" />
        </Grid.RowDefinitions>

        <!-- Hijo superior: inicio / centro / fin. El panel centra el indicador
            respecto a la ventana y deja a los laterales su ancho natural, así que
            las acciones nunca se recortan. -->
        <controls:SymmetricBarPanel Grid.Row="0" CenterRatio="0.3333">

            <!-- Inicio: posición del cursor y codificación del documento activo -->
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="11,0,0,0"
                        FontFamily="{DynamicResource CodeFontFamily}" FontWeight="Medium" FontSize="{DynamicResource FontSizeSmall}"
                        Foreground="{DynamicResource ChromeAccentBrush}">
                <Run Text="{Binding CaretPosition, Mode=OneWay}" />
                <Run Text="   " />
                <Run Text="{Binding Encoding, Mode=OneWay}" />
                <Run Text="   " />
                <Run Text="{Binding ProblemsSummary, Mode=OneWay}" />
            </TextBlock>

            
            <!-- Centro: indicador del estado del proyecto -->
            <Grid ClipToBounds="True">

                <!-- Trapecio de fondo del indicador -->
                <Path
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Width="212"
                    Height="28"
                    IsHitTestVisible="False"
                    Stretch="Fill"
                    Fill="{DynamicResource StatusIndicatorBackgroundBrush}"
                    Data="M14,0 L198,0 L212,28 L0,28 Z" />

                <!-- Estado de compilación y ejecución -->
                <TextBlock
                    Text="{Binding ProjectStatusText}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource CodeFontFamily}"
                    FontWeight="SemiBold"
                    FontSize="{DynamicResource FontSizeSmall}"
                    Foreground="{DynamicResource StatusIndicatorForegroundBrush}">

                </TextBlock>

            </Grid>


            <!-- Fin: acciones del proyecto (STOP solo activo durante RUN). Botones
                de 20 en una barra de 34: 7px arriba y abajo. Cierra el grupo una figura
                con la misma forma pero con el lateral derecho recto, pegada al borde. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <Button Style="{StaticResource StatusPrimaryActionButton}" Content="COMPILE"
                        Command="{Binding Commands.Compile}" />
                <Button Style="{StaticResource StatusPrimaryActionButton}" Content="RUN"
                        Command="{Binding Commands.Run}" />
                <Button Style="{StaticResource StatusStopActionButton}" Content="STOP"
                        Command="{Binding Commands.Stop}" />
                <!-- 26x20 (25% del ancho de un botón). Geometría a tamaño real, sin
                    Stretch, para conservar la inclinación de 3.5px de los botones. -->
                <Path Width="26" Height="20" Margin="8,0,0,0" IsHitTestVisible="False"
                        Fill="{DynamicResource StatusActionsTailBrush}"
                        Data="M0,0 L26,0 L26,20 L3.5,20 Z" />
            </StackPanel>
        </controls:SymmetricBarPanel>

        <!-- Hijo inferior: franja del borde inferior -->
        <Grid Grid.Row="1" Background="{DynamicResource WindowBandBrush}" />
    </Grid>
</UserControl>
