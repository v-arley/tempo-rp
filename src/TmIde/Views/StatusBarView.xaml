<UserControl x:Class="TmIde.Views.StatusBarView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:design="clr-namespace:TmIde.Design"
            mc:Ignorable="d"
            d:DataContext="{x:Static design:DesignData.StatusBar}"
            d:DesignWidth="900"
            Height="34">

    <!-- Footer: misma distribución que el header, reflejada. Contenedor principal
            a todo el ancho con dos hijos en columna.
            Fila 0: barra en tres secciones de igual ancho
                    (indicadores | reservado | acciones).
            Fila 1: franja inferior oscura de 6px.
            Sin Border: los fondos van en Grid. -->
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="6" />
        </Grid.RowDefinitions>

        <!-- Hijo superior: izquierda / centro / derecha, un tercio cada una -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Izquierda: posición del cursor y codificación del documento activo -->
            <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="11,0,0,0"
                        FontFamily="{DynamicResource CodeFontFamily}" FontWeight="Medium" FontSize="11"
                        Foreground="{DynamicResource TitleMenuForegroundBrush}">
                <Run Text="{Binding CaretPosition, Mode=OneWay}" />
                <Run Text="   " />
                <Run Text="{Binding Encoding, Mode=OneWay}" />
                <Run Text="   " />
                <Run Text="{Binding Problems, Mode=OneWay}" />
            </TextBlock>

            <!-- Centro: contenedor que ocupa todo el segmento central y, dentro, la
                placa trapezoidal que sube desde la franja inferior (reflejo de la
                del header). Decorativa; queda libre para contenido futuro. -->
            <Grid Grid.Column="1">
                <Path HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Width="212" Height="22" IsHitTestVisible="False"
                        Stretch="Fill" Fill="{DynamicResource DividerBrush}"
                        Data="M14,0 L198,0 L212,22 L0,22 Z" />
            </Grid>

            <!-- Derecha: botones decorativos, sin acción asociada. Botones de 16 en
                una barra de 28: 6px arriba y abajo. Cierra el grupo una figura con la
                misma forma pero con el lateral derecho recto, pegada al borde. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <Button Style="{StaticResource StatusActionButton}" Content="COMPILE" />
                <Button Style="{StaticResource StatusActionButton}" Content="RUN" />
                <Button Style="{StaticResource StatusActionButton}" Content="DEBUG" />
                <!-- 22x16 (25% del ancho de un botón). Geometría a tamaño real, sin
                    Stretch, para conservar la inclinación de 3px de los botones. -->
                <Path Width="22" Height="16" Margin="8,0,0,0" IsHitTestVisible="False"
                        Fill="{DynamicResource ChromeShapeBrush}"
                        Data="M0,0 L22,0 L22,16 L3,16 Z" />
            </StackPanel>
        </Grid>

        <!-- Hijo inferior: franja oscura -->
        <Grid Grid.Row="1" Background="{DynamicResource DividerBrush}" />
    </Grid>
</UserControl>
