<UserControl x:Class="TmIde.Views.Editor.EditorHostView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:controls="clr-namespace:TmIde.Controls"
            xmlns:design="clr-namespace:TmIde.Design"
            mc:Ignorable="d"
            d:DataContext="{x:Static design:DesignData.Editor}"
            d:DesignWidth="700" d:DesignHeight="480">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Franja de acento con las pestañas de los documentos abiertos -->
        <Border Grid.Row="0" Background="{DynamicResource AccentBrush}">
            <TabControl HorizontalAlignment="Right"
                        Background="Transparent"
                        ItemsSource="{Binding Documents}"
                        SelectedItem="{Binding SelectedDocument, Mode=TwoWay}">
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                        <!-- Texto claro fijo: la pestaña inactiva se lee sobre el acento -->
                        <Setter Property="Foreground" Value="#B6C1D3" />
                        <Setter Property="Margin" Value="6,0,0,0" />
                        <Setter Property="Padding" Value="16,5" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <!-- Pestaña rectangular con borde de 1 px -->
                                    <Border x:Name="Chrome" Background="{DynamicResource AccentBrush}"
                                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <!-- Aclarado del acento al pasar el cursor -->
                                            <Setter TargetName="Chrome" Property="Background" Value="#D14A3B" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                <TabControl.ContentTemplate>
                    <DataTemplate />
                </TabControl.ContentTemplate>
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" FontSize="12" />
                            <Button Command="{Binding CloseCommand}"
                                    Margin="8,0,0,0" Padding="2"
                                    ToolTip="Cerrar pestaña">
                                <!-- Icono claro fijo, a juego con el texto de la pestaña sobre el acento -->
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconWindowClose}"
                                        Width="10" Height="10" Fill="#B6C1D3" />
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
        </Border>

        <!-- Ruta de navegación (breadcrumb) del documento activo -->
        <ItemsControl Grid.Row="1"
                        ItemsSource="{Binding Breadcrumb}"
                        Background="{DynamicResource WindowBackgroundBrush}"
                        Padding="12,5">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Text}" FontSize="10.5"
                                    Foreground="{DynamicResource SecondaryForegroundBrush}" />
                        <TextBlock Text="  /  " FontSize="10.5"
                                    Foreground="{DynamicResource TertiaryForegroundBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Área de edición del documento activo -->
        <controls:LineNumberedTextBox Grid.Row="2"
                                        Text="{Binding SelectedDocument.Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                                        CaretLine="{Binding SelectedDocument.CaretLine, Mode=TwoWay, FallbackValue=1}"
                                        CaretColumn="{Binding SelectedDocument.CaretColumn, Mode=TwoWay, FallbackValue=1}" />
    </Grid>
</UserControl>
