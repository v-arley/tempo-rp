<UserControl x:Class="TmIde.Views.Editor.EditorHostView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:controls="clr-namespace:TmIde.Controls"
            xmlns:design="clr-namespace:TmIde.Design"
            mc:Ignorable="d"
            d:DataContext="{x:Static design:DesignData.Editor}"
            d:DesignWidth="700" d:DesignHeight="480">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Contenedor principal de las pestañas (franja de acento), sin márgenes ni
            relleno lateral. Fila 0 (3px) = espacio superior; fila 1 (22px) = figura
            decorativa + pestañas, alineadas a la izquierda y asentadas en el borde
            inferior. Alto total 25.
            Estructura: contenedor principal > (por cada archivo abierto) contenedor
            de pestaña (TabItem) > figura + texto. -->
        <Grid Grid.Row="0" Background="{DynamicResource AccentBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="3" />
                <RowDefinition Height="22" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Figura decorativa fija al inicio, antes de todas las pestañas (visible
                aunque no haya documentos): lateral izquierdo recto y el derecho con la
                misma inclinación que las pestañas, 22px de ancho. -->
            <Grid Grid.Row="1" Grid.Column="0" Width="22" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Fill="#1B212A" />
                <Path Grid.Column="1" Stretch="Fill" Fill="#1B212A" Data="M0,0 L1,1 L0,1 Z" />
            </Grid>

            <!-- El TabControl genera un contenedor (TabItem) por cada documento de
                Documents: abrir un archivo añade uno nuevo. -->
            <TabControl Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left"
                        Background="Transparent"
                        ItemsSource="{Binding Documents}"
                        SelectedItem="{Binding SelectedDocument, Mode=TwoWay}">
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                        <!-- Pestaña inactiva: fondo oscuro fijo con texto claro -->
                        <Setter Property="Foreground" Value="#B6C1D3" />
                        <Setter Property="Background" Value="{DynamicResource ChromeShapeBrush}" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Height" Value="22" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <!-- Contenedor de la pestaña: figura + texto superpuestos -->
                                    <Grid>
                                        <!-- Figura: paralelogramo (ambos laterales inclinados en
                                            el mismo sentido) en tres piezas; los laterales (8px)
                                            se estiran solo en alto, así la inclinación no
                                            cambia con la longitud del nombre. -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Stretch="Fill" Fill="{TemplateBinding Background}"
                                                    Data="M0,0 L1,0 L1,1 Z" />
                                            <Rectangle Grid.Column="1" Fill="{TemplateBinding Background}" />
                                            <Path Grid.Column="2" Stretch="Fill" Fill="{TemplateBinding Background}"
                                                    Data="M0,0 L1,1 L0,1 Z" />
                                        </Grid>
                                        <!-- Texto: columnas de 18 (8 de lateral inclinado + 10
                                            libres) a cada lado en lugar de márgenes, para que
                                            el contenido nunca toque la diagonal. -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="18" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <!-- Aclarado del fondo oscuro al pasar el cursor -->
                                            <Setter Property="Background" Value="{DynamicResource ChromeShapeHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                <TabControl.ContentTemplate>
                    <DataTemplate />
                </TabControl.ContentTemplate>
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Nombre + botón de cerrar; la separación de 8 es una
                            columna, no un margen -->
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Foreground local enlazado a la pestaña: sin él, el estilo
                                implícito global de TextBlock impondría el color oscuro -->
                            <TextBlock Grid.Column="0" Text="{Binding FileName}" VerticalAlignment="Center" FontSize="12"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                            <Button Grid.Column="2" Command="{Binding CloseCommand}"
                                    Padding="2"
                                    ToolTip="Cerrar pestaña">
                                <!-- Icono claro fijo, a juego con el texto de la pestaña sobre el acento -->
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconWindowClose}"
                                        Width="10" Height="10" Fill="#B6C1D3" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
        </Grid>

        <!-- Ruta de navegación (breadcrumb) del documento activo -->
        <ItemsControl Grid.Row="1"
                        ItemsSource="{Binding Breadcrumb}"
                        Background="{DynamicResource WindowBackgroundBrush}"
                        Padding="12,5">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Text}" FontSize="10.5"
                                    Foreground="{DynamicResource SecondaryForegroundBrush}" />
                        <TextBlock Text="  •  " FontSize="10.5"
                                    Foreground="{DynamicResource TertiaryForegroundBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Área de edición del documento activo -->
        <controls:LineNumberedTextBox Grid.Row="2"
                                        Document="{Binding SelectedDocument.Document}"
                                        CaretLine="{Binding SelectedDocument.CaretLine, Mode=TwoWay, FallbackValue=1}"
                                        CaretColumn="{Binding SelectedDocument.CaretColumn, Mode=TwoWay, FallbackValue=1}"
                                        Diagnostics="{Binding SelectedDocument.Diagnostics}" />
    </Grid>
</UserControl>
