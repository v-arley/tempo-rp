<UserControl x:Class="TmIde.Views.Editor.EditorHostView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
            xmlns:behaviors="clr-namespace:TmIde.Views.Behaviors"
            xmlns:controls="clr-namespace:TmIde.Controls"
            xmlns:design="clr-namespace:TmIde.Design"
            mc:Ignorable="d"
            d:DataContext="{x:Static design:DesignData.Editor}"
            d:DesignWidth="700" d:DesignHeight="480">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Contenedor principal de las pestañas (franja de acento), sin márgenes ni
            relleno lateral. Fila 0 (3px) = espacio superior; fila 1 (22px) = figura
            decorativa + pestañas, alineadas a la izquierda y asentadas en el borde
            inferior. Alto total 25.
            Estructura: contenedor principal > (por cada archivo abierto) contenedor
            de pestaña (TabItem) > figura + texto. -->
        <Grid Grid.Row="0" Background="{DynamicResource AccentBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="3" />
                <RowDefinition Height="22" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Figura decorativa fija al inicio, antes de todas las pestañas (visible
                aunque no haya documentos): lateral izquierdo recto y el derecho con la
                misma inclinación que las pestañas, 22px de ancho. -->
            <Grid Grid.Row="1" Grid.Column="0" Width="22" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Fill="{DynamicResource TabStripLeadBrush}" />
                <Path Grid.Column="1" Stretch="Fill" Fill="{DynamicResource TabStripLeadBrush}" Data="M0,0 L1,1 L0,1 Z" />
            </Grid>

            <!-- Un TabItem por cada documento de Documents, en una sola fila
                desplazable: la rueda la recorre en horizontal y la pestaña activa
                se mantiene a la vista. El margen de -8 mete la fila bajo el lateral
                inclinado de la figura decorativa. -->
            <TabControl Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left"
                        Margin="-8,0,0,0"
                        Background="Transparent"
                        ItemsSource="{Binding Documents}"
                        SelectedItem="{Binding SelectedDocument, Mode=TwoWay}">
                <b:Interaction.Behaviors>
                    <behaviors:TabStripScrollBehavior />
                </b:Interaction.Behaviors>
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <!-- Fila desplazable con dos cuñas de 8px que cortan sus bordes con
                            la diagonal de las pestañas. Cada cuña ocupa el hueco que deja
                            el lateral inclinado de una pestaña, por eso solo se ve cuando
                            corta una pestaña parcialmente visible. -->
                        <Grid>
                            <!-- Desplazamiento horizontal sin barra visible -->
                            <ScrollViewer x:Name="PART_HeaderScroller"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          CanContentScroll="False"
                                          Focusable="False">
                                <!-- Margen de 8: la primera pestaña empieza justo después de la figura decorativa -->
                                <StackPanel Orientation="Horizontal" IsItemsHost="True" Margin="8,0,0,0" />
                            </ScrollViewer>
                            <!-- Cuña izquierda: prolonga el lateral inclinado de la figura decorativa -->
                            <Path Width="8" HorizontalAlignment="Left" Stretch="Fill" IsHitTestVisible="False"
                                  Fill="{DynamicResource TabStripLeadBrush}" Data="M0,0 L1,1 L0,1 Z" />
                            <!-- Cuña derecha: del color de la franja, recorta la pestaña en diagonal -->
                            <Path Width="8" HorizontalAlignment="Right" Stretch="Fill" IsHitTestVisible="False"
                                  Fill="{DynamicResource AccentBrush}" Data="M0,0 L1,0 L1,1 Z" />
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                        <!-- Pestaña inactiva; la activa la redefinen los triggers -->
                        <Setter Property="Foreground" Value="{DynamicResource InactiveTabForegroundBrush}" />
                        <Setter Property="Background" Value="{DynamicResource InactiveTabBackgroundBrush}" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Height" Value="22" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <!-- Contenedor de la pestaña: figura + texto superpuestos -->
                                    <Grid>
                                        <!-- Figura: paralelogramo (ambos laterales inclinados en
                                            el mismo sentido) en tres piezas; los laterales (8px)
                                            se estiran solo en alto, así la inclinación no
                                            cambia con la longitud del nombre. -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Stretch="Fill" Fill="{TemplateBinding Background}"
                                                    Data="M0,0 L1,0 L1,1 Z" />
                                            <Rectangle Grid.Column="1" Fill="{TemplateBinding Background}" />
                                            <Path Grid.Column="2" Stretch="Fill" Fill="{TemplateBinding Background}"
                                                    Data="M0,0 L1,1 L0,1 Z" />
                                        </Grid>
                                        <!-- Texto: columnas de 18 (8 de lateral inclinado + 10
                                            libres) a cada lado en lugar de márgenes, para que
                                            el contenido nunca toque la diagonal. -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="18" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <!-- Realce de la pestaña inactiva al pasar el cursor -->
                                            <Setter Property="Background" Value="{DynamicResource InactiveTabHoverBackgroundBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ActiveTabBackgroundBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource ActiveTabForegroundBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                <TabControl.ContentTemplate>
                    <DataTemplate />
                </TabControl.ContentTemplate>
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Nombre + botón de cerrar; la separación de 8 es una
                            columna, no un margen -->
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Foreground local enlazado a la pestaña: sin él, el estilo
                                implícito global de TextBlock impondría el color oscuro -->
                            <TextBlock Grid.Column="0" Text="{Binding FileName}" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBody}"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                            <Button Grid.Column="2" Command="{Binding CloseCommand}"
                                    Padding="2"
                                    ToolTip="Cerrar pestaña">
                                <!-- Color del icono según el estado de la pestaña -->
                                <Path Data="{StaticResource IconWindowClose}" Width="10" Height="10">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                                            <Setter Property="Fill" Value="{DynamicResource InactiveTabCloseIconBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource ActiveTabCloseIconBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
        </Grid>

        <!-- Ruta de navegación (breadcrumb) del documento activo -->
        <ItemsControl Grid.Row="1"
                        ItemsSource="{Binding Breadcrumb}"
                        Background="{DynamicResource DocumentPathBackgroundBrush}"
                        Padding="12,5">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Text}" FontSize="{DynamicResource FontSizeCaption}"
                                    Foreground="{DynamicResource DocumentPathForegroundBrush}" />
                        <TextBlock Text="  •  " FontSize="{DynamicResource FontSizeCaption}"
                                    Foreground="{DynamicResource DocumentPathSeparatorBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Área de edición del documento activo -->
        <controls:CodeEditor
                Grid.Row="2"
                Piano="{Binding DataContext.Piano,
                            RelativeSource={RelativeSource AncestorType=Window}}"
                Document="{Binding SelectedDocument.Document}"
                CaretLine="{Binding SelectedDocument.CaretLine,
                            Mode=TwoWay,
                            FallbackValue=1}"
                CaretColumn="{Binding SelectedDocument.CaretColumn,
                            Mode=TwoWay,
                            FallbackValue=1}"
                Diagnostics="{Binding SelectedDocument.Diagnostics}"
                Outline="{Binding SelectedDocument.Outline}"
                ActionRequest="{Binding ActionRequest}"
                NavigationRequest="{Binding NavigationRequest}" />
    </Grid>
</UserControl>
