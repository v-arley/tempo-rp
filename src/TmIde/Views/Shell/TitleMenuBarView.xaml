<UserControl x:Class="TmIde.Views.Shell.TitleMenuBarView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:vm="clr-namespace:TmIde.ViewModels"
            xmlns:design="clr-namespace:TmIde.Design"
            mc:Ignorable="d"
            d:DataContext="{x:Static design:DesignData.MainWindow}"
            d:DesignWidth="900"
            Height="34">

    <UserControl.Resources>
        <Style x:Key="MenuEntryStyle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding Header}" />
            <Setter Property="ItemsSource" Value="{Binding Items}" />
            <Setter Property="Command" Value="{Binding Command}" />
            <Setter Property="ItemContainerStyle" Value="{DynamicResource MenuEntryStyle}" />
        </Style>

        <!-- Botón de operación de ventana dentro del grupo en pastilla recesada -->
        <Style x:Key="CaptionGroupButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <!-- Cuadrado 24x24 con glifo de 8x8: 8px de relleno en los 4 lados -->
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#33000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#4A000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionGroupCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionGroupButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CloseButtonHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionGlyph" TargetType="Path">
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{DynamicResource SecondaryForegroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Stroke" Value="{DynamicResource PrimaryForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseGlyph" TargetType="Path">
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{DynamicResource SecondaryForegroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Stroke" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Header: contenedor principal a todo el ancho con dos hijos en columna.
            Fila 0: franja superior oscura, más baja que la barra.
            Fila 1: barra en tres secciones (menús | título | operaciones de ventana).
            Sin Border: los fondos van en Grid y las líneas en Rectangle/Path. -->
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="6" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Hijo superior: franja oscura -->
        <Grid Grid.Row="0" Background="{DynamicResource DividerBrush}" />

        <!-- Hijo inferior: izquierda / centro / derecha. Los laterales son iguales
            (el título queda centrado respecto a la ventana) y el centro es más
            ancho (1.5*). -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Menús y toggle PIANO -->
                <ColumnDefinition Width="*" MinWidth="350" />

                <!-- Título central -->
                <ColumnDefinition Width="1.5*" />

                <!-- Botones de ventana -->
                <ColumnDefinition Width="*" MinWidth="350" />
            </Grid.ColumnDefinitions>

            <!-- Centro: contenedor que ocupa todo el segmento central y, dentro, la
                placa trapezoidal que cuelga de la franja superior con el nombre del
                archivo abierto encima (decorativa, no interactiva). La fila de 22
                es la altura de la placa, para centrar el título sobre ella. -->
            <Grid Grid.Column="1" IsHitTestVisible="False" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="22" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Placa a todo el ancho del segmento, en tres piezas para que los
                    chaflanes laterales mantengan 14px de inclinación a cualquier ancho
                    (un único Path con Stretch=Fill los deformaría). -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Fill="{DynamicResource DividerBrush}"
                            Data="M0,0 L14,0 L14,22 Z" />
                    <Rectangle Grid.Column="1" Fill="{DynamicResource DividerBrush}" />
                    <Path Grid.Column="2" Fill="{DynamicResource DividerBrush}"
                            Data="M0,0 L14,0 L0,22 Z" />
                </Grid>
                <TextBlock Grid.Row="0" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            FontFamily="{DynamicResource HeaderFontFamily}"
                            FontSize="{DynamicResource FontSizeSmall}" FontWeight="Medium"
                            Foreground="#A4B1C7" />
            </Grid>

            <!-- Izquierda: menús raíz separados por "|" (MENU / TOOLS / VER / OTROS) -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="3,0,0,0">

                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding ShowMenus,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Value="False">

                                        <Setter Property="Visibility" Value="Collapsed" />

                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                <StackPanel.Resources>
                    <Style x:Key="MenuSep" TargetType="Rectangle">
                        <Setter Property="Width" Value="1" />
                        <Setter Property="Height" Value="14" />
                        <Setter Property="Margin" Value="10,0" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Fill" Value="{DynamicResource TitleMenuForegroundBrush}" />
                        <Setter Property="Opacity" Value="0.7" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                    </Style>
                    <Style x:Key="RootMenuItem" TargetType="MenuItem" BasedOn="{StaticResource MenuEntryStyle}">
                        <Setter Property="FontFamily" Value="{DynamicResource CodeFontFamily}" />
                        <Setter Property="FontWeight" Value="Medium" />
                        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                        <Setter Property="Foreground" Value="{DynamicResource TitleMenuForegroundBrush}" />
                        <Setter Property="Padding" Value="8,3" />
                        <!-- Hover: subrayado inferior que crece de izquierda a derecha,
                            sin relleno de fondo. -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="MenuItem">
                                    <Grid x:Name="Chrome" Background="Transparent">
                                        <ContentPresenter ContentSource="Header"
                                                            Margin="{TemplateBinding Padding}"
                                                            VerticalAlignment="Center"
                                                            RecognizesAccessKey="True" />
                                        <Rectangle x:Name="Underline"
                                                Height="2"
                                                VerticalAlignment="Bottom"
                                                Fill="{DynamicResource AccentBrush}"
                                                RenderTransformOrigin="0,0.5">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform x:Name="UnderlineScale" ScaleX="0" ScaleY="1" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                        <Popup x:Name="PART_Popup"
                                                Placement="Bottom"
                                                IsOpen="{TemplateBinding IsSubmenuOpen}"
                                                AllowsTransparency="True"
                                                Focusable="False"
                                                PopupAnimation="Fade">
                                            <Grid Background="{DynamicResource SurfaceBackgroundBrush}"
                                                    SnapsToDevicePixels="True">
                                                <StackPanel Margin="4" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                            </Grid>
                                        </Popup>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="UnderlineScale"
                                                                            Storyboard.TargetProperty="ScaleX"
                                                                            To="1" Duration="0:0:0.18">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="UnderlineScale"
                                                                            Storyboard.TargetProperty="ScaleX"
                                                                            To="0" Duration="0:0:0.12" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.4" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>

                <Menu Background="Transparent" VerticalAlignment="Center" Padding="0">
                    <MenuItem DataContext="{Binding MenuBar.Roots[0]}" Style="{StaticResource RootMenuItem}" />
                </Menu>
                <Rectangle Style="{StaticResource MenuSep}" />
                <Menu Background="Transparent" VerticalAlignment="Center" Padding="0">
                    <MenuItem DataContext="{Binding MenuBar.Roots[1]}" Style="{StaticResource RootMenuItem}" />
                </Menu>
                <Rectangle Style="{StaticResource MenuSep}" />
                <Menu Background="Transparent" VerticalAlignment="Center" Padding="0">
                    <MenuItem DataContext="{Binding MenuBar.Roots[2]}" Style="{StaticResource RootMenuItem}" />
                </Menu>
                <Rectangle Style="{StaticResource MenuSep}" />
                <Menu Background="Transparent" VerticalAlignment="Center" Padding="0">
                    <MenuItem DataContext="{Binding MenuBar.Roots[3]}" Style="{StaticResource RootMenuItem}" />
                </Menu>

                
                <!-- Toggle musical: No se muestra en ventanas auxiliares porque el StackPanel de menús se oculta con ShowMenus=False. -->
                <ToggleButton
                    IsChecked="{Binding Piano.Enabled, Mode=TwoWay}"
                    ToolTip="Activar o desactivar el piano al escribir"
                    Height="23"
                    Margin="4,0,0,0"
                    Padding="4,2"
                    VerticalAlignment="Center"
                    Focusable="False"
                    Cursor="Hand">

                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">

                            <Border
                                x:Name="PianoBorder"
                                Background="Transparent"
                                BorderBrush="{DynamicResource SecondaryForegroundBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">

                                <StackPanel
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                                    <TextBlock
                                        Text="♫ PIANO"
                                        FontFamily="{DynamicResource CodeFontFamily}"
                                        FontSize="{DynamicResource FontSizeSmall}"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource TitleMenuForegroundBrush}"
                                        VerticalAlignment="Center" />

                                    <Ellipse
                                        x:Name="PianoLight"
                                        Width="6"
                                        Height="6"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Fill="{DynamicResource TertiaryForegroundBrush}" />

                                </StackPanel>

                            </Border>

                            <ControlTemplate.Triggers>

                                <!-- Piano encendido -->
                                <Trigger Property="IsChecked" Value="True">

                                    <Setter
                                        TargetName="PianoBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />

                                    <Setter
                                        TargetName="PianoLight"
                                        Property="Fill"
                                        Value="{DynamicResource AccentBrush}" />

                                    <Setter
                                        TargetName="PianoBorder"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceBackgroundBrush}" />

                                </Trigger>

                                <!-- Efecto al pasar el mouse -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter
                                        TargetName="PianoBorder"
                                        Property="Opacity"
                                        Value="0.8" />
                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </ToggleButton.Template>

                </ToggleButton>


            </StackPanel>

            
            <!-- Identificación de las ventanas auxiliares -->
            <TextBlock
                Grid.Column="0"
                Text="AYUDA"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontFamily="{DynamicResource CodeFontFamily}"
                FontSize="{DynamicResource FontSizeSmall}"
                FontWeight="Medium"
                Foreground="{DynamicResource TitleMenuForegroundBrush}">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">

                        <Setter Property="Visibility"
                                Value="Collapsed" />

                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding ShowMenus,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Value="False">

                                <Setter Property="Visibility"
                                        Value="Visible" />

                            </DataTrigger>
                        </Style.Triggers>

                    </Style>
                </TextBlock.Style>

            </TextBlock>


            <!-- Derecha: operaciones de ventana. Botones de 24 en una barra de 28:
                2px arriba y abajo. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        HorizontalAlignment="Right" Margin="0,0,3,0">
                <Button Style="{StaticResource CaptionGroupButton}" Click="OnMinimize" ToolTip="Minimizar">
                    <Path Style="{StaticResource CaptionGlyph}" Width="8" Height="8"
                            Data="{StaticResource IconCaptionMin}" />
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionGroupButton}" Click="OnMaximizeRestore" ToolTip="Maximizar / restaurar">
                    <Path x:Name="MaximizeGlyph" Style="{StaticResource CaptionGlyph}" Width="8" Height="8"
                            Data="{StaticResource IconCaptionMax}" />
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CaptionGroupCloseButton}" Click="OnClose" ToolTip="Cerrar">
                    <Path Style="{StaticResource CloseGlyph}" Width="8" Height="8"
                            Data="{StaticResource IconCaptionClose}" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
