<UserControl x:Class="TmIde.Views.Shell.TitleMenuBarView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:vm="clr-namespace:TmIde.ViewModels"
            xmlns:controls="clr-namespace:TmIde.Controls"
            xmlns:design="clr-namespace:TmIde.Design"
            mc:Ignorable="d"
            d:DataContext="{x:Static design:DesignData.MainWindow}"
            d:DesignWidth="900"
            Height="40">

    <UserControl.Resources>
        <Style x:Key="MenuEntryStyle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding Header}" />
            <Setter Property="ItemsSource" Value="{Binding Items}" />
            <Setter Property="Command" Value="{Binding Command}" />
            <Setter Property="ItemContainerStyle" Value="{DynamicResource MenuEntryStyle}" />
        </Style>

        <!-- Botón de operación de ventana dentro del grupo en pastilla recesada -->
        <Style x:Key="CaptionGroupButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <!-- Cuadrado 24x24 con glifo de 8x8: 8px de relleno en los 4 lados -->
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#33000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#4A000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionGroupCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionGroupButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CloseButtonHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionGlyph" TargetType="Path">
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{DynamicResource SecondaryForegroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Stroke" Value="{DynamicResource PrimaryForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseGlyph" TargetType="Path">
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{DynamicResource SecondaryForegroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Stroke" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>


        <!-- Selector visible del modo musical -->
        <Style x:Key="PianoModeHeaderToggle"
            TargetType="ToggleButton">

            <Setter Property="Content" Value="ESCRITURA" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TitleMenuForegroundBrush}" />
            <Setter Property="FontFamily"
                    Value="{DynamicResource CodeFontFamily}" />
            <Setter Property="FontSize"
                    Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="23" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">

                        <Border x:Name="ModeBorder"
                                Background="Transparent"
                                BorderBrush="{DynamicResource SecondaryForegroundBrush}"
                                BorderThickness="1"
                                Padding="7,0">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock Text="MODO"
                                        Foreground="{DynamicResource TitleMenuForegroundBrush}"
                                        FontSize="{DynamicResource FontSizeSmall}"
                                        Margin="0,0,7,0"
                                        VerticalAlignment="Center" />

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />

                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder"
                                        Property="Background"
                                        Value="{DynamicResource HoverBackgroundBrush}" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ModeBorder"
                                        Property="Background"
                                        Value="#33000000" />
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>

                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content"
                            Value="INTERPRETACIÓN" />
                </Trigger>

                <DataTrigger
                    Binding="{Binding ShowMenus,
                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Value="False">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                </DataTrigger>

            </Style.Triggers>
        </Style>

        <!-- Botones para cambiar la octava -->
        <Style x:Key="PianoOctaveHeaderButton"
            TargetType="Button"
            BasedOn="{StaticResource {x:Type Button}}">

            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TitleMenuForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

    </UserControl.Resources>

    <!-- Header: contenedor principal a todo el ancho con dos hijos en columna.
            Fila 0: franja del borde superior, más baja que la barra.
            Fila 1: barra en tres secciones (menús | título | operaciones de ventana).
            Sin Border: los fondos van en Grid y las líneas en Rectangle/Path. -->
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="6" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- Hijo superior: franja del borde superior -->
        <Grid Grid.Row="0" Background="{DynamicResource WindowBandBrush}" />

        <!-- Hijo inferior: inicio / centro / fin. El panel centra el título respecto
            a la ventana a cualquier ancho: la placa mide 3/7 del ancho (proporción
            1 : 1.5 : 1) y se estrecha por igual a ambos lados antes de tocar el
            lateral más ancho. -->
        <controls:SymmetricBarPanel Grid.Row="1" CenterRatio="0.4286">

            <!-- Inicio: menús de la ventana principal o rótulo de las auxiliares -->
            <Grid>

                <!-- Menús raíz separados por "|", generados desde MenuBar.Roots
                    (MENU / EDITAR / EJECUCIÓN / VER / AYUDA): añadir un menú en el modelo
                    de vista basta para que aparezca aquí. -->
                <ItemsControl ItemsSource="{Binding MenuBar.Roots}"
                              VerticalAlignment="Center" HorizontalAlignment="Left" Margin="3,0,0,0"
                              Focusable="False">

                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding ShowMenus,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Value="False">

                                    <Setter Property="Visibility" Value="Collapsed" />

                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>

                    <ItemsControl.Resources>
                        <Style x:Key="MenuSep" TargetType="Rectangle">
                            <Setter Property="Width" Value="1" />
                            <Setter Property="Height" Value="14" />
                            <Setter Property="Margin" Value="10,0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Fill" Value="{DynamicResource TitleMenuForegroundBrush}" />
                            <Setter Property="Opacity" Value="0.7" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                        </Style>

                        <!--
                            Fila del desplegable. Columnas: marcador | etiqueta | atajo.
                            Al resaltarse, el marcador crece desde el centro y la fila se tiñe
                            del acento.
                        -->
                        <Style x:Key="DropdownEntry" TargetType="MenuItem" BasedOn="{StaticResource MenuEntryStyle}">
                            <Setter Property="FontFamily" Value="{DynamicResource CodeFontFamily}" />
                            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                            <Setter Property="Foreground" Value="{StaticResource OverlaySecondaryTextBrush}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="MenuItem">
                                        <Grid Height="28" Background="Transparent" SnapsToDevicePixels="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Tinte de la fila resaltada -->
                                            <Rectangle x:Name="Wash" Grid.ColumnSpan="3" Fill="{DynamicResource AccentBrush}" Opacity="0" />

                                            <Rectangle Grid.Column="0" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                                                <Rectangle.RenderTransform>
                                                    <ScaleTransform x:Name="MarkerScale" ScaleX="1" ScaleY="0" />
                                                </Rectangle.RenderTransform>
                                            </Rectangle>

                                            <TextBlock x:Name="Label" Grid.Column="1" Margin="12,0,28,0" VerticalAlignment="Center"
                                                       FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       Text="{Binding Header}" />

                                            <TextBlock x:Name="Shortcut" Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center"
                                                       FontFamily="{TemplateBinding FontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{StaticResource OverlayMutedTextBrush}"
                                                       Text="{Binding Shortcut}"
                                                       Visibility="{Binding HasShortcut, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="Label" Property="Foreground" Value="#F2F5F8" />
                                                <Setter TargetName="Shortcut" Property="Foreground" Value="{StaticResource OverlaySecondaryTextBrush}" />
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="MarkerScale" Storyboard.TargetProperty="ScaleY"
                                                                             To="1" Duration="0:0:0.16">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity"
                                                                             To="0.16" Duration="0:0:0.12" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="MarkerScale" Storyboard.TargetProperty="ScaleY"
                                                                             To="0" Duration="0:0:0.10" />
                                                            <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.10" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style x:Key="RootMenuItem" TargetType="MenuItem" BasedOn="{StaticResource MenuEntryStyle}">
                            <Setter Property="FontFamily" Value="{DynamicResource CodeFontFamily}" />
                            <Setter Property="FontWeight" Value="Medium" />
                            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                            <Setter Property="Foreground" Value="{DynamicResource TitleMenuForegroundBrush}" />
                            <Setter Property="Padding" Value="8,3" />
                            <Setter Property="ItemContainerStyle" Value="{StaticResource DropdownEntry}" />
                            <!-- Hover: subrayado inferior que crece de izquierda a derecha,
                                sin relleno de fondo. -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="MenuItem">
                                        <Grid x:Name="Chrome" Background="Transparent">
                                            <ContentPresenter ContentSource="Header"
                                                                Margin="{TemplateBinding Padding}"
                                                                VerticalAlignment="Center"
                                                                RecognizesAccessKey="True" />
                                            <Rectangle x:Name="Underline"
                                                    Height="2"
                                                    VerticalAlignment="Bottom"
                                                    Fill="{DynamicResource ChromeAccentBrush}"
                                                    RenderTransformOrigin="0,0.5">
                                                <Rectangle.RenderTransform>
                                                    <ScaleTransform x:Name="UnderlineScale" ScaleX="0" ScaleY="1" />
                                                </Rectangle.RenderTransform>
                                            </Rectangle>

                                            <!--
                                                Desplegable: se desliza bajo el menú raíz. Franja de acento y filas
                                                de entradas. La sombra va en una capa propia para no desenfocar el texto.
                                            -->
                                            <Popup x:Name="PART_Popup"
                                                    Placement="Bottom"
                                                    IsOpen="{TemplateBinding IsSubmenuOpen}"
                                                    AllowsTransparency="True"
                                                    Focusable="False"
                                                    PopupAnimation="Slide">
                                                <Grid Margin="0,0,14,14" MinWidth="240" SnapsToDevicePixels="True">
                                                    <Border Background="{StaticResource OverlayShadowBrush}">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="5" Direction="290" Opacity="0.55" />
                                                        </Border.Effect>
                                                    </Border>

                                                    <Border Background="{DynamicResource PanelOverlayBrush}"
                                                            BorderBrush="{StaticResource OverlayEdgeBrush}" BorderThickness="1,0,1,1">
                                                        <DockPanel>
                                                            <Rectangle DockPanel.Dock="Top" Height="2" Fill="{DynamicResource AccentBrush}" />

                                                            <StackPanel Margin="0,4,0,5" IsItemsHost="True"
                                                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                                                        </DockPanel>
                                                    </Border>
                                                </Grid>
                                            </Popup>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="UnderlineScale"
                                                                                Storyboard.TargetProperty="ScaleX"
                                                                                To="1" Duration="0:0:0.18">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="UnderlineScale"
                                                                                Storyboard.TargetProperty="ScaleX"
                                                                                To="0" Duration="0:0:0.12" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ItemsControl.Resources>

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <!-- Cada menú raíz va precedido de "|" salvo el primero -->
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle x:Name="Separator" Style="{StaticResource MenuSep}" />
                                <Menu Background="Transparent" VerticalAlignment="Center" Padding="0">
                                    <MenuItem Style="{StaticResource RootMenuItem}" />
                                </Menu>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                    <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            
                <!-- Identificación de las ventanas auxiliares -->
                <TextBlock
                    Text="AYUDA"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource CodeFontFamily}"
                    FontSize="{DynamicResource FontSizeSmall}"
                    FontWeight="Medium"
                    Foreground="{DynamicResource TitleMenuForegroundBrush}">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">

                            <Setter Property="Visibility"
                                    Value="Collapsed" />

                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding ShowMenus,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Value="False">

                                    <Setter Property="Visibility"
                                            Value="Visible" />

                                </DataTrigger>
                            </Style.Triggers>

                        </Style>
                    </TextBlock.Style>

                </TextBlock>

            </Grid>

            <!-- Centro: placa trapezoidal que cuelga de la franja superior con el
                nombre del archivo abierto encima (decorativa, no interactiva). La fila
                de 28 es la altura de la placa, para centrar el título sobre ella. -->
            <Grid IsHitTestVisible="False" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Placa a todo el ancho del centro, en tres piezas para que los
                    chaflanes laterales mantengan 14px de inclinación a cualquier ancho
                    (un único Path con Stretch=Fill los deformaría). -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Fill="{DynamicResource WindowBandBrush}"
                            Data="M0,0 L14,0 L14,28 Z" />
                    <Rectangle Grid.Column="1" Fill="{DynamicResource WindowBandBrush}" />
                    <Path Grid.Column="2" Fill="{DynamicResource WindowBandBrush}"
                            Data="M0,0 L14,0 L0,28 Z" />
                </Grid>
                <TextBlock Grid.Row="0" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis" Margin="16,0"
                            FontFamily="{DynamicResource HeaderFontFamily}"
                            FontSize="{DynamicResource FontSizeSmall}" FontWeight="Medium"
                            Foreground="{DynamicResource TitlePlateForegroundBrush}" />
            </Grid>

            <!-- Fin: toggle PIANO y operaciones de ventana. Botones de 24 en una
                barra de 34: 5px arriba y abajo. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        HorizontalAlignment="Right" Margin="0,0,3,0">
                <!-- Toggle musical junto a los botones de ventana: siempre a la vista sin
                    competir con los menús. No aparece en ventanas auxiliares (ShowMenus=False). -->
                <ToggleButton
                    IsChecked="{Binding Piano.Enabled, Mode=TwoWay}"
                    ToolTip="Clic: activar/desactivar sonido. Clic derecho: elegir modo y octava."
                    Height="23"
                    Margin="0,0,10,0"
                    Padding="4,2"
                    VerticalAlignment="Center"
                    Focusable="False"
                    Cursor="Hand">

                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding ShowMenus,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>

                    <!-- Menú contextual del piano -->
                    <ToggleButton.ContextMenu>

                        <ContextMenu
                            DataContext="{Binding PlacementTarget.DataContext,
                                                RelativeSource={RelativeSource Self}}"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            Padding="4">
                            <ContextMenu.Template>
                                <ControlTemplate TargetType="{x:Type ContextMenu}">
                                    <Border
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">

                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </ControlTemplate>
                            </ContextMenu.Template>

                            <!-- Colores específicos para las opciones del piano -->                          
                            <ContextMenu.Resources>

                                <!-- Estilo propio para las opciones del piano -->
                                <Style TargetType="{x:Type MenuItem}">

                                    <Setter Property="Foreground"
                                            Value="{DynamicResource PrimaryForegroundBrush}" />

                                    <Setter Property="FontFamily"
                                            Value="{DynamicResource CodeFontFamily}" />

                                    <Setter Property="FontSize"
                                            Value="{DynamicResource FontSizeSmall}" />

                                    <Setter Property="Padding"
                                            Value="8,6" />

                                    <Setter Property="Template">
                                        <Setter.Value>

                                            <ControlTemplate TargetType="{x:Type MenuItem}">

                                                <!-- Fondo uniforme, sin franja blanca -->
                                                <Border
                                                    x:Name="ItemBackground"
                                                    Background="Transparent"
                                                    CornerRadius="2"
                                                    Padding="{TemplateBinding Padding}">

                                                    <Grid>

                                                        <Grid.ColumnDefinitions>
                                                            <!-- Espacio para la marca -->
                                                            <ColumnDefinition Width="22" />

                                                            <!-- Texto de la opción -->
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Marca cuando la opción está activada -->
                                                        <TextBlock
                                                            x:Name="CheckMark"
                                                            Grid.Column="0"
                                                            Text="✓"
                                                            FontWeight="Bold"
                                                            Foreground="{DynamicResource AccentBrush}"
                                                            VerticalAlignment="Center"
                                                            Visibility="Collapsed" />

                                                        <!-- Contenido del menú -->
                                                        <ContentPresenter
                                                            Grid.Column="1"
                                                            ContentSource="Header"
                                                            RecognizesAccessKey="True"
                                                            VerticalAlignment="Center" />

                                                    </Grid>

                                                </Border>

                                                <ControlTemplate.Triggers>

                                                    <!-- Opción seleccionada -->
                                                    <Trigger Property="IsChecked"
                                                            Value="True">

                                                        <Setter
                                                            TargetName="CheckMark"
                                                            Property="Visibility"
                                                            Value="Visible" />

                                                    </Trigger>

                                                    <!-- Mouse sobre una opción -->
                                                    <Trigger Property="IsHighlighted"
                                                            Value="True">

                                                        <Setter
                                                            TargetName="ItemBackground"
                                                            Property="Background"
                                                            Value="{DynamicResource HoverBackgroundBrush}" />

                                                    </Trigger>

                                                    <!-- Opciones informativas deshabilitadas -->
                                                    <Trigger Property="IsEnabled"
                                                            Value="False">

                                                        <Setter
                                                            Property="Foreground"
                                                            Value="{DynamicResource SecondaryForegroundBrush}" />

                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>

                                        </Setter.Value>
                                    </Setter>

                                </Style>

                                <!-- Separadores con el estilo de Tempo -->
                                <Style TargetType="{x:Type Separator}">

                                    <Setter Property="Template">
                                        <Setter.Value>

                                            <ControlTemplate TargetType="{x:Type Separator}">

                                                <Border
                                                    Height="1"
                                                    Margin="8,5"
                                                    Background="{DynamicResource SecondaryForegroundBrush}"
                                                    Opacity="0.4" />

                                            </ControlTemplate>

                                        </Setter.Value>
                                    </Setter>

                                </Style>

                            </ContextMenu.Resources>


                            <!-- Activar modo interpretación -->
                            <MenuItem
                                Header="Modo interpretación (sin escribir código)"
                                IsCheckable="True"
                                IsChecked="{Binding Piano.IsPerformanceMode,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}" />

                            <Separator />

                            <!-- Octava actual -->
                            <MenuItem
                                Header="{Binding Piano.OctaveLabel}"
                                IsEnabled="False" />

                            <!-- Controles de octava -->
                            <MenuItem
                                Header="Subir octava (X)"
                                Click="OnPianoOctaveUp" />

                            <MenuItem
                                Header="Bajar octava (Z)"
                                Click="OnPianoOctaveDown" />

                            <Separator />

                            <!-- Instrucciones -->
                            <MenuItem
                                Header="En modo interpretación: Esc vuelve a escritura"
                                IsEnabled="False" />

                        </ContextMenu>

                    </ToggleButton.ContextMenu>



                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">

                            <Border
                                x:Name="PianoBorder"
                                Background="Transparent"
                                BorderBrush="{DynamicResource SecondaryForegroundBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">

                                <StackPanel
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                                    <TextBlock
                                        Text="{Binding Piano.ToggleLabel}"
                                        FontFamily="{DynamicResource CodeFontFamily}"
                                        FontSize="{DynamicResource FontSizeSmall}"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource TitleMenuForegroundBrush}"
                                        VerticalAlignment="Center" />

                                    <Ellipse
                                        x:Name="PianoLight"
                                        Width="6"
                                        Height="6"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Fill="{DynamicResource TertiaryForegroundBrush}" />

                                </StackPanel>

                            </Border>

                            <ControlTemplate.Triggers>

                                <!-- Piano encendido -->
                                <Trigger Property="IsChecked" Value="True">

                                    <Setter
                                        TargetName="PianoBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />

                                    <Setter
                                        TargetName="PianoLight"
                                        Property="Fill"
                                        Value="{DynamicResource AccentBrush}" />

                                    <Setter
                                        TargetName="PianoBorder"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceBackgroundBrush}" />

                                </Trigger>

                                <!-- Efecto al pasar el mouse -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter
                                        TargetName="PianoBorder"
                                        Property="Opacity"
                                        Value="0.8" />
                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </ToggleButton.Template>

                </ToggleButton>


                <!-- Selector directo del modo musical -->
                <ToggleButton
                    Style="{StaticResource PianoModeHeaderToggle}"
                    IsChecked="{Binding Piano.IsPerformanceMode,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding Piano.Enabled}"
                    ToolTip="Cambiar entre modo escritura y modo interpretación" />

                <!-- Indicador y controles de octava -->
                <Border Height="23"
                        Margin="0,0,10,0"
                        Padding="5,0"
                        Background="Transparent"
                        BorderBrush="{DynamicResource SecondaryForegroundBrush}"
                        BorderThickness="1"
                        IsEnabled="{Binding Piano.Enabled}"
                        VerticalAlignment="Center">

                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>

                                <DataTrigger
                                    Binding="{Binding ShowMenus,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Value="False">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- Bajar octava -->
                        <Button Content="−"
                                Style="{StaticResource PianoOctaveHeaderButton}"
                                Click="OnPianoOctaveDown"
                                ToolTip="Bajar octava (Z)" />

                        <!-- Octava actual -->
                        <TextBlock Text="OCT"
                                Foreground="{DynamicResource TitleMenuForegroundBrush}"
                                FontFamily="{DynamicResource CodeFontFamily}"
                                FontSize="{DynamicResource FontSizeSmall}"
                                VerticalAlignment="Center"
                                Margin="3,0,4,0" />

                        <TextBlock Text="{Binding Piano.Octave}"
                                Foreground="{DynamicResource TitleMenuForegroundBrush}"
                                FontFamily="{DynamicResource CodeFontFamily}"
                                FontSize="{DynamicResource FontSizeSmall}"
                                FontWeight="Bold"
                                Width="16"
                                TextAlignment="Center"
                                VerticalAlignment="Center" />

                        <!-- Subir octava -->
                        <Button Content="+"
                                Style="{StaticResource PianoOctaveHeaderButton}"
                                Click="OnPianoOctaveUp"
                                ToolTip="Subir octava (X)" />

                    </StackPanel>
                </Border>


                <Button Style="{StaticResource CaptionGroupButton}" Click="OnMinimize" ToolTip="Minimizar">
                    <Path Style="{StaticResource CaptionGlyph}" Width="8" Height="8"
                            Data="{StaticResource IconCaptionMin}" />
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionGroupButton}" Click="OnMaximizeRestore" ToolTip="Maximizar / restaurar">
                    <Path x:Name="MaximizeGlyph" Style="{StaticResource CaptionGlyph}" Width="8" Height="8"
                            Data="{StaticResource IconCaptionMax}" />
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CaptionGroupCloseButton}" Click="OnClose" ToolTip="Cerrar">
                    <Path Style="{StaticResource CloseGlyph}" Width="8" Height="8"
                            Data="{StaticResource IconCaptionClose}" />
                </Button>
            </StackPanel>
        </controls:SymmetricBarPanel>
    </Grid>
</UserControl>
