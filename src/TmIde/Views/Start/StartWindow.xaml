<Window x:Class="TmIde.Views.Start.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:TmIde.ViewModels.Start"        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:StartViewModel}"
        Title="Inicio"
        Width="760" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Acción principal "Nuevo proyecto": bloque rojo pegado al borde izquierdo
            con el lateral derecho inclinado (pieza de 20px estirada en alto), como la
            cabecera TMIDE. Se aclara en hover, se oscurece al pulsar y se atenúa
            deshabilitado. Los estados van en Style.Triggers (no en la plantilla)
            para que las variantes puedan cambiar sus colores. -->
        <Style x:Key="StartActionLeftButton" TargetType="Button">
            <Setter Property="Background" Value="#BF3B2C" />
            <Setter Property="Foreground" Value="#E4E9F0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Fill="{TemplateBinding Background}" />
                            <Path Grid.Column="1" Stretch="Fill" Fill="{TemplateBinding Background}"
                                    Data="M0,0 L1,0 L0,1 Z" />
                            <ContentPresenter Grid.Column="0" Margin="20,10,16,10"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D14636" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#A33223" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Variante oscura (#20262E) de la acción izquierda, para acciones
            secundarias ("VOLVER"). -->
        <Style x:Key="StartSecondaryLeftButton" TargetType="Button"
                BasedOn="{StaticResource StartActionLeftButton}">
            <Setter Property="Background" Value="{DynamicResource StartBarBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A323D" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#12171D" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Acción principal "Abrir proyecto": reflejo de la anterior (pegada al
            borde derecho, lateral izquierdo inclinado), como la cabecera RECIENTES. -->
        <Style x:Key="StartActionRightButton" TargetType="Button"
                BasedOn="{StaticResource StartActionLeftButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Stretch="Fill" Fill="{TemplateBinding Background}"
                                    Data="M1,0 L1,1 L0,1 Z" />
                            <Rectangle Grid.Column="1" Fill="{TemplateBinding Background}" />
                            <ContentPresenter Grid.Column="1" Margin="16,10,20,10"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cerrar del header: 24x24 con glifo de 8, rojo en hover (como el cerrar
            de la ventana principal) -->
        <Style x:Key="StartCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CloseButtonHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StartCloseGlyph" TargetType="Path">
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <!-- Claro: la barra del header es oscura (#20262E) -->
            <Setter Property="Stroke" Value="#8C99AD" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Stroke" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Proyecto reciente: contenedor de tres filas.
                Fila 0: franja #1B212A de 3px (separación superior).
                Fila 1: tres columnas:
                            0 · lateral #BF3B2C
                            1 · información (nombre + ruta) sobre #1B212A
                            2 · lateral #BF3B2C
                Fila 2: franja #1B212A de 3px (separación inferior).
            En hover y seleccionado (IsSelected) se aclara la celda de información;
            al pulsar se oscurece. Entre accesos hay un gap de 8px (margen inferior)
            además de las franjas. -->
        <Style x:Key="RecentProjectButton" TargetType="Button">
            <Setter Property="Background" Value="#1B212A" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="#1B212A">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="3" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="3" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Row="1" Grid.Column="0" Fill="#BF3B2C" />
                            <Grid Grid.Row="1" Grid.Column="1" Background="{TemplateBinding Background}">
                                <ContentPresenter Margin="17,6" />
                            </Grid>
                            <Rectangle Grid.Row="1" Grid.Column="2" Fill="#BF3B2C" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="#2A323D" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A323D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#12171D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plantilla "tarjetas": cada proyecto reciente es un botón con nombre, ruta y fecha
            (estilo RecentProjectButton). -->
        <DataTemplate x:Key="RecentItemClassic">
            <Button Style="{StaticResource RecentProjectButton}"
                    Command="{Binding DataContext.ActivateRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium"
                                    Foreground="#E4E9F0" />
                        <TextBlock Text="{Binding Path}" FontSize="10.5" Margin="0,2,0,0"
                                    FontFamily="{DynamicResource CodeFontFamily}"
                                    Foreground="#8C99AD"
                                    TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding LastOpened}" FontSize="10.5"
                                VerticalAlignment="Top" Margin="12,1,0,0"
                                Foreground="#8C99AD" />
                    <Path Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                            Stroke="#8C99AD" StrokeThickness="1.5"
                            Data="M0,5 L12,5 M8,1 L12,5 L8,9" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Plantilla "filas planas": sin tarjeta, solo una línea fina como
            separador. Icono de carpeta, nombre y ruta, fecha a la derecha. La marca
            roja de 3px a la izquierda y la flecha aparecen en hover / selección. -->
        <Style x:Key="RecentRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="Mark" Grid.Column="0" Fill="#BF3B2C" Visibility="Hidden" />
                            <ContentPresenter Grid.Column="1" Margin="14,10,12,10" />
                            <Rectangle Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom"
                                    Fill="{DynamicResource StartCaptionBrush}" Opacity="0.18" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="#14FFFFFF" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0DFFFFFF" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1F000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RecentItemRows">
            <Button Style="{StaticResource RecentRowButton}"
                    Command="{Binding DataContext.ActivateRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform" Margin="0,0,14,0"
                            VerticalAlignment="Center" Fill="#8C99AD" Data="{StaticResource IconFolder}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium"
                                    Foreground="{DynamicResource PrimaryForegroundBrush}" />
                        <TextBlock Text="{Binding Path}" FontSize="10.5" Margin="0,2,0,0"
                                    FontFamily="{DynamicResource CodeFontFamily}"
                                    Foreground="#8C99AD" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding LastOpened}" FontSize="10.5"
                                VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#8C99AD" />
                    <Path Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"
                            StrokeThickness="1.5" Stroke="#BF3B2C" Data="M0,5 L12,5 M8,1 L12,5 L8,9"
                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Plantilla "línea de tiempo": los proyectos son nodos sobre un riel
            vertical, con la fecha a la derecha (como un historial de
            commits). El nodo seleccionado se rellena de rojo con un halo. -->
        <Style x:Key="RecentTimelineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1F000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RecentItemTimeline">
            <Button x:Name="Row" Style="{StaticResource RecentTimelineButton}"
                    Command="{Binding DataContext.ActivateRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Grid MinHeight="54">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Riel + nodo -->
                    <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Center"
                            Fill="{DynamicResource StartCaptionBrush}" Opacity="0.35" />
                    <Grid Grid.Column="1" Width="22" Height="22" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Ellipse x:Name="Halo" Stroke="#BF3B2C" StrokeThickness="1" Opacity="0" />
                        <Ellipse x:Name="Node" Width="9" Height="9"
                                Fill="{DynamicResource StartCentralBrush}"
                                Stroke="{DynamicResource StartTextDimBrush}" StrokeThickness="1.5" />
                    </Grid>

                    <StackPanel x:Name="TextStack" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform X="0" />
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="Title" Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                    Foreground="{DynamicResource StartTextBrush}" />
                        <TextBlock x:Name="PathText" Text="{Binding Path}" FontSize="10.5" Margin="0,2,0,0"
                                    FontFamily="{DynamicResource CodeFontFamily}"
                                    Foreground="{DynamicResource StartTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- A la derecha: pista de apertura (solo en la fila seleccionada) y
                        fecha relativa -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,16,0">
                        <StackPanel x:Name="OpenHint" Orientation="Horizontal" Visibility="Collapsed"
                                Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="ABRIR" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource StartAccentTextBrush}"
                                        FontFamily="{DynamicResource CodeFontFamily}" Margin="0,0,8,0"
                                        VerticalAlignment="Center" />
                            <Grid>
                                <Rectangle Fill="{DynamicResource StartVeilSelectedBrush}" Stroke="{DynamicResource StartTextDimBrush}" StrokeThickness="1"
                                        RadiusX="3" RadiusY="3" />
                                <TextBlock Text="ENTER ↵" Margin="8,3" FontSize="10" FontWeight="Medium"
                                            FontFamily="{DynamicResource CodeFontFamily}" Foreground="{DynamicResource StartTextStrongBrush}" />
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="{Binding LastOpened}" VerticalAlignment="Center" FontSize="10.5"
                                    FontFamily="{DynamicResource CodeFontFamily}" Foreground="{DynamicResource StartTextDimBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <!-- Hover: solo cambia el color de la tipografía (sin fondo) -->
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource StartAccentTextBrush}" />
                    <Setter TargetName="PathText" Property="Foreground" Value="{DynamicResource StartTextStrongBrush}" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="TextStack" Storyboard.TargetProperty="RenderTransform.X"
                                                 To="6" Duration="0:0:0.12" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="TextStack" Storyboard.TargetProperty="RenderTransform.X"
                                                 To="0" Duration="0:0:0.12" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Node" Property="Fill" Value="#BF3B2C" />
                    <Setter TargetName="Node" Property="Stroke" Value="#BF3B2C" />
                    <Setter TargetName="Halo" Property="Opacity" Value="0.7" />
                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource StartTextStrongBrush}" />
                    <Setter TargetName="OpenHint" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Etiquetas / valores del detalle: monoespaciado como el footer -->
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource CodeFontFamily}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#8C99AD" />
            <Setter Property="Margin" Value="0,0,16,4" />
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock" BasedOn="{StaticResource DetailLabel}">
            <Setter Property="Foreground" Value="#E4E9F0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Título de sección sobre el fondo claro del central ("PROYECTOS
            RECIENTES", "NUEVO PROYECTO") y etiquetas de campo del formulario -->
        <Style x:Key="SectionCaption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource CodeFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource StartCaptionBrush}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionCaption}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- Campo de texto del formulario: mismo contenedor que los accesos a
            recientes (laterales #BF3B2C de 3px y celda #1B212A), que se aclara al
            tener el foco. -->
        <Style x:Key="StartTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1B212A" />
            <Setter Property="Foreground" Value="#E4E9F0" />
            <Setter Property="CaretBrush" Value="#E4E9F0" />
            <Setter Property="SelectionBrush" Value="#BF3B2C" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="3" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Fill="#BF3B2C" />
                            <Grid Grid.Column="1" Background="{TemplateBinding Background}">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="14,0"
                                        VerticalAlignment="Center" />
                            </Grid>
                            <Rectangle Grid.Column="2" Fill="#BF3B2C" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#2A323D" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón pequeño junto a un campo ("EXAMINAR"): bloque #20262E del alto
            del campo -->
        <Style x:Key="StartFieldButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource StartBarBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="14,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A323D" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#12171D" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Paneles del central: se ocultan con Collapsed: solo el panel visible
            cuenta en la medida, así la ventana se ajusta al alto de la vista activa
            (la de inicio queda compacta y crece al abrir el formulario). -->
        <Style x:Key="StartPanel" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNewProjectMode}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NewProjectPanel" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNewProjectMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding BackCommand}" />
        <KeyBinding Key="F1" Command="{Binding ShowHelpCommand}" />
    </Window.InputBindings>

    <!-- Contenedor principal en dos filas, sin marcos exteriores:
            0 · header a todo el ancho (barra "INICIO" / ayuda / cerrar)
            1 · central: acciones | recientes | detalle -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header (zona de arrastre): barra de 28px con el texto "INICIO", el
            acceso a la ayuda y el de cerrar. -->
        <Grid Grid.Row="0" Background="{DynamicResource WindowBackgroundBrush}"
                MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <Grid Height="28" Background="{DynamicResource StartBarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding HeaderTitle}" VerticalAlignment="Center" Margin="20,0,0,0"
                            FontFamily="{DynamicResource HeaderFontFamily}" FontSize="11" FontWeight="Medium"
                            Foreground="#8C99AD" />
                <!-- Acceso discreto a la guía: texto tenue que se aclara en hover -->
                <Button Grid.Column="1" Command="{Binding ShowHelpCommand}" ToolTip="Guía de inicio (F1)"
                        Cursor="Hand" Margin="0,0,10,0" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock x:Name="Label" Text="? AYUDA" VerticalAlignment="Center" Padding="6,0"
                                        FontFamily="{DynamicResource HeaderFontFamily}" FontSize="10"
                                        FontWeight="Medium" Foreground="#6F7B87" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Label" Property="Foreground" Value="#E4E9F0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource StartCloseButton}"
                        Command="{Binding CloseCommand}" ToolTip="Cerrar (Esc)">
                    <Path Style="{StaticResource StartCloseGlyph}" Width="8" Height="8"
                            Data="{StaticResource IconCaptionClose}" />
                </Button>
            </Grid>
        </Grid>

        <!-- Central sobre fondo #A4B1C7 con dos vistas superpuestas en la misma
            celda (ver estilos StartPanel / NewProjectPanel):
                · inicio: acciones | recientes | detalle
                · nuevo proyecto: acciones | formulario | vista previa -->
    <Grid Grid.Row="1" Background="{DynamicResource StartCentralBrush}">

        <!-- Vista de inicio, en dos filas:
                0 · acciones: nuevo proyecto | (vacío) | abrir proyecto
                1 · lista de proyectos recientes, centrada en ambos ejes (un clic
                    selecciona, un segundo clic abre) -->
        <Grid Style="{StaticResource StartPanel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Fila 0 · acciones: bloques rojos pegados a cada borde, separados
                16px de la barra del header. La columna central queda vacía. -->
            <Grid Grid.Row="0" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Izquierda: abrir proyecto (bloque pegado al borde izquierdo, con el texto a la derecha del icono) -->
                <Button Grid.Column="0" Style="{StaticResource StartActionLeftButton}"
                        Command="{Binding OpenProjectCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="16" Height="16" Stretch="Uniform" Fill="#E4E9F0"
                                Data="{StaticResource IconFolder}" />
                        <!-- Diagonal decorativa entre icono y texto -->
                        <Path Margin="12,0,0,0" VerticalAlignment="Center" Stroke="#E4E9F0" Opacity="0.55"
                                StrokeThickness="1.5" Data="M8,0 L0,26" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ABRIR PROYECTO"
                                        FontFamily="{DynamicResource HeaderFontFamily}" FontSize="18"
                                        FontWeight="Medium" Foreground="#E4E9F0" />
                            <TextBlock Text="seleccionar un proyecto existente" FontSize="11" Margin="0,1,0,0"
                                        Foreground="#E4E9F0" Opacity="0.75" />
                        </StackPanel>
                        <Path Margin="16,0,0,0" VerticalAlignment="Center" Stroke="#E4E9F0"
                                StrokeThickness="1.5" Data="M0,5 L12,5 M8,1 L12,5 L8,9" />
                    </StackPanel>
                </Button>

                <!-- Columna central: vacía -->

                <!-- Derecha: nuevo proyecto -->
                <Button Grid.Column="2" Style="{StaticResource StartActionRightButton}"
                        Command="{Binding NewProjectCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Margin="0,0,16,0" VerticalAlignment="Center" Stroke="#E4E9F0"
                                StrokeThickness="1.5" Data="M12,5 L0,5 M4,1 L0,5 L4,9" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NUEVO PROYECTO" HorizontalAlignment="Right"
                                        FontFamily="{DynamicResource HeaderFontFamily}" FontSize="18"
                                        FontWeight="Medium" Foreground="#E4E9F0" />
                            <TextBlock Text="crear un proyecto desde cero" FontSize="11" Margin="0,1,0,0"
                                        HorizontalAlignment="Right" Foreground="#E4E9F0" Opacity="0.75" />
                        </StackPanel>
                        <!-- Diagonal decorativa entre texto e icono -->
                        <Path Margin="12,0,12,0" VerticalAlignment="Center" Stroke="#E4E9F0" Opacity="0.55"
                                StrokeThickness="1.5" Data="M8,0 L0,26" />
                        <Path Width="16" Height="16" Stretch="Uniform" Fill="#E4E9F0"
                                Data="{StaticResource IconFile}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Fila 1 · recientes: bloque de ancho fijo centrado en ambos ejes -->
            <Grid Grid.Row="1" Margin="20,2,20,2" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Prolongación del riel hacia arriba (altura fija) y hacia abajo (rellena
                    el resto hasta el borde): ambos extremos dejan el mismo margen de 2px
                    contra los botones y contra el borde de la ventana. Misma x que el riel
                    de los ítems: columna 6 + mitad de 36. -->
                <Rectangle Grid.Row="0" Width="1" Height="12" HorizontalAlignment="Left" Margin="23.5,0,0,0"
                        Fill="{DynamicResource StartCaptionBrush}" Opacity="0.35" />
                <!-- Diseño de la lista: RecentItemTimeline (línea de tiempo), RecentItemRows (filas planas) o
                    RecentItemClassic (tarjetas). La plantilla activa se elige con la
                    clave de ItemTemplate. -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentProjects}"
                        ItemTemplate="{StaticResource RecentItemTimeline}" />
                <Rectangle Grid.Row="2" Width="1" MinHeight="12" HorizontalAlignment="Left" Margin="23.5,0,0,0"
                        Fill="{DynamicResource StartCaptionBrush}" Opacity="0.35" />

                <TextBlock Grid.Row="1" Text="No hay proyectos recientes." HorizontalAlignment="Center" FontSize="12"
                            Foreground="{DynamicResource StartTextDimBrush}"
                            Visibility="{Binding IsRecentEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>

        <!-- Vista "Nuevo proyecto", en dos filas como la de inicio:
                0 · acciones: volver | (vacío) | crear proyecto
                1 · formulario (nombre + ubicación) a todo el ancho, con el resumen
                    de lo que se creará integrado debajo (sin panel aparte)
            La visibilidad se evalúa contra StartViewModel (este Grid); el
            contenido interior usa el formulario como DataContext. -->
        <Grid Style="{StaticResource NewProjectPanel}">
            <Grid DataContext="{Binding NewProjectForm}" d:DataContext="{d:DesignInstance Type=vm:NewProjectViewModel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Fila 0 · acciones: mismas piezas que la vista de inicio, con flecha y
                    subtítulo. Volver (bloque oscuro) y crear (bloque rojo, deshabilitado
                    mientras el formulario no es válido) -->
                <Grid Grid.Row="0" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource StartSecondaryLeftButton}"
                            Command="{Binding CancelCommand}" ToolTip="Volver al inicio (Esc)">
                        <StackPanel Orientation="Horizontal">
                            <Path VerticalAlignment="Center" Stroke="#E4E9F0" StrokeThickness="1.5"
                                    Data="M12,5 L0,5 M4,1 L0,5 L4,9" />
                            <Path Margin="14,0,0,0" VerticalAlignment="Center" Stroke="#E4E9F0" Opacity="0.55"
                                    StrokeThickness="1.5" Data="M8,0 L0,26" />
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="VOLVER"
                                            FontFamily="{DynamicResource HeaderFontFamily}" FontSize="18"
                                            FontWeight="Medium" Foreground="#E4E9F0" />
                                <TextBlock Text="regresar al inicio" FontSize="11" Margin="0,1,0,0"
                                            Foreground="#E4E9F0" Opacity="0.75" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource StartActionRightButton}"
                            Command="{Binding CreateCommand}" IsDefault="True">
                        <StackPanel Orientation="Horizontal">
                            <Path Margin="0,0,16,0" VerticalAlignment="Center" Stroke="#E4E9F0"
                                    StrokeThickness="1.5" Data="M12,5 L0,5 M4,1 L0,5 L4,9" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="CREAR PROYECTO" HorizontalAlignment="Right"
                                            FontFamily="{DynamicResource HeaderFontFamily}" FontSize="18"
                                            FontWeight="Medium" Foreground="#E4E9F0" />
                                <TextBlock Text="generar el proyecto en disco" FontSize="11" Margin="0,1,0,0"
                                            HorizontalAlignment="Right" Foreground="#E4E9F0" Opacity="0.75" />
                            </StackPanel>
                            <Path Margin="12,0,12,0" VerticalAlignment="Center" Stroke="#E4E9F0" Opacity="0.55"
                                    StrokeThickness="1.5" Data="M8,0 L0,26" />
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="#E4E9F0"
                                    Data="{StaticResource IconFile}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Fila 1 · formulario: a todo el ancho (mismo margen que la lista de
                    recientes), centrado en vertical -->
                <StackPanel Grid.Row="1" Margin="20,10,20,8"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <!-- Título con líneas a ambos lados -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Height="1" Fill="{DynamicResource StartCaptionBrush}" Opacity="0.45"
                                VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Text="NUEVO PROYECTO"
                                    Style="{StaticResource SectionCaption}" />
                        <Rectangle Grid.Column="2" Height="1" Fill="{DynamicResource StartCaptionBrush}" Opacity="0.45"
                                VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>

                    <TextBlock Text="NOMBRE" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NewProjectNameBox" Style="{StaticResource StartTextBox}"
                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="UBICACIÓN" Margin="0,8,0,4" Style="{StaticResource SectionCaption}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource StartTextBox}"
                                FontFamily="{DynamicResource CodeFontFamily}" FontSize="11.5"
                                Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource StartFieldButton}"
                                Command="{Binding BrowseCommand}" ToolTip="Elegir carpeta">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="13" Height="13" Stretch="Uniform" Fill="#B6C1D3"
                                        Data="{StaticResource IconFolder}" />
                                <TextBlock Text="EXAMINAR" Margin="8,0,0,0" VerticalAlignment="Center"
                                            FontFamily="{DynamicResource CodeFontFamily}" FontSize="11"
                                            FontWeight="Medium" Foreground="#E4E9F0" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Resumen de lo que se creará bajo el formulario: rótulo
                        tenue + valor, con el riel rojo a la izquierda -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Fill="#BF3B2C" />
                        <StackPanel Grid.Column="1" Margin="14,1,0,1">
                            <TextBlock FontFamily="{DynamicResource CodeFontFamily}" FontSize="11"
                                        TextTrimming="CharacterEllipsis" Foreground="{DynamicResource StartCaptionBrush}">
                                <Run Text="CARPETA   " Foreground="{DynamicResource StartTextMutedBrush}" /><Run Text="{Binding ProjectPath, Mode=OneWay}" FontWeight="Medium" />
                            </TextBlock>
                            <TextBlock FontFamily="{DynamicResource CodeFontFamily}" FontSize="11" Margin="0,3,0,0"
                                        TextTrimming="CharacterEllipsis" Foreground="{DynamicResource StartCaptionBrush}">
                                <Run Text="PRINCIPAL " Foreground="{DynamicResource StartTextMutedBrush}" /><Run Text="{Binding MainFilePath, Mode=OneWay}" FontWeight="Medium" />
                            </TextBlock>
                            <TextBlock Margin="0,6,0,0" FontSize="10.5" Foreground="{DynamicResource StartCaptionBrush}"
                                        Opacity="0.7" Text="Se crea con una sesión «Hola, Mundo» lista para ejecutar" />
                        </StackPanel>
                    </Grid>

                    <!-- Motivo por el que no se puede crear (alto reservado para que
                        el formulario no salte al aparecer) -->
                    <TextBlock Margin="0,6,0,0" MinHeight="16" FontSize="11.5" FontWeight="Medium"
                                Foreground="{DynamicResource StartErrorBrush}" TextWrapping="Wrap"
                                Text="{Binding ValidationMessage}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
    </Grid>
</Window>
