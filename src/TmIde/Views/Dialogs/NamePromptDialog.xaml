
<Window x:Class="TmIde.Views.Dialogs.NamePromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Nueva carpeta"
        Width="480" Height="250"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Botones rectangulares -->
        <Style x:Key="FlatDialogButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Width" Value="112" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                            <Border x:Name="HoverLayer"
                                    Background="#22FFFFFF"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer"
                                        Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverLayer"
                                        Property="Background" Value="#33000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Campo de texto sin bordes redondeados -->
        <Style x:Key="FolderTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryForegroundBrush}" />
            <Setter Property="CaretBrush"
                    Value="{DynamicResource PrimaryForegroundBrush}" />
            <Setter Property="SelectionBrush"
                    Value="{DynamicResource SurfaceAccentBrush}" />
            <Setter Property="FontFamily"
                    Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                Padding="12,0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón X igual al estilo del IDE -->
        <Style x:Key="DialogCloseButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="CloseChrome"
                              Background="{TemplateBinding Background}">
                            <Path x:Name="CloseGlyph"
                                  Data="{StaticResource IconCaptionClose}"
                                  Stroke="{DynamicResource SecondaryForegroundBrush}"
                                  StrokeThickness="1"
                                  Width="8" Height="8"
                                  Stretch="None"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseChrome"
                                        Property="Background"
                                        Value="{DynamicResource CloseButtonHoverBrush}" />
                                <Setter TargetName="CloseGlyph"
                                        Property="Stroke" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Marco principal -->
    <Border BorderBrush="{StaticResource OverlayEdgeBrush}"
            BorderThickness="1"
            Background="{DynamicResource SurfaceBackgroundBrush}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="3" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra de título personalizada -->
            <Grid Grid.Row="0"
                  Background="{DynamicResource WindowBackgroundBrush}"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Placa geométrica del título -->
                <Grid Grid.Column="1" Height="34">
                    <Path Data="M0,0 L240,0 L230,34 L10,34 Z"
                          Stretch="Fill"
                          Fill="{DynamicResource WindowBandBrush}" />

                    <TextBlock x:Name="DialogTitle"
                                Text="NUEVA CARPETA"
                               Foreground="{DynamicResource TitlePlateForegroundBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Cerrar -->
                <Button Grid.Column="2"
                        Style="{StaticResource DialogCloseButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        ToolTip="Cerrar"
                        Click="Close_Click" />
            </Grid>

            <!-- Línea roja -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceAccentBrush}" />

            <!-- Contenido -->
            <Grid Grid.Row="2" Margin="24,22,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Mensaje -->
                <TextBlock x:Name="PromptLabel"
                           Grid.Row="0"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <!-- Entrada del nombre -->
                <Border Grid.Row="1"
                        Height="44"
                        Background="{DynamicResource HoverBackgroundBrush}">

                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource SecondaryForegroundBrush}" />
                            <Setter Property="BorderThickness" Value="1" />

                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin"
                                         Value="True">
                                    <Setter Property="BorderBrush"
                                            Value="{DynamicResource SurfaceAccentBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBox x:Name="NameTextBox"
                             Style="{StaticResource FolderTextBox}"
                             VerticalContentAlignment="Center" />
                </Border>

                <!-- Acciones -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Cancelar"
                            IsCancel="True"
                            Style="{StaticResource FlatDialogButton}"
                            Background="{DynamicResource HoverBackgroundBrush}"
                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                            Margin="0,0,10,0"
                            Click="Cancel_Click" />

                    <Button Content="Aceptar"
                            IsDefault="True"
                            Style="{StaticResource FlatDialogButton}"
                            Background="{DynamicResource SurfaceAccentBrush}"
                            Foreground="{DynamicResource SurfaceAccentForegroundBrush}"
                            Click="Accept_Click" />

                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
