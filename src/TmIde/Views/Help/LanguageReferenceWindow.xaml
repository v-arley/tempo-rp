
<Window x:Class="TmIde.Views.Help.LanguageReferenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tempo - Referencia del lenguaje"
        Width="940"
        Height="640"
        MinWidth="740"
        MinHeight="480"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>

        <!-- Opciones del navegador lateral -->
        <Style x:Key="ReferenceNavigationItem"
               TargetType="ListBoxItem">

            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryForegroundBrush}" />

            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">

                        <Border x:Name="ItemBackground"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">

                            <ContentPresenter
                                VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ItemBackground"
                                        Property="Background"
                                        Value="{DynamicResource HoverBackgroundBrush}" />
                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="ItemBackground"
                                        Property="Background"
                                        Value="{DynamicResource HoverBackgroundBrush}" />
                                <Setter Property="FontWeight"
                                        Value="SemiBold" />
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botones visibles, sin depender del estilo global -->
        <Style x:Key="ReferenceButton"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryForegroundBrush}" />

            <Setter Property="Background"
                    Value="{DynamicResource HoverBackgroundBrush}" />

            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputBorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Opacity"
                                        Value="0.8" />
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0"
                Background="{DynamicResource WindowBackgroundBrush}"
                Padding="24,17"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">

            <StackPanel>

                <TextBlock
                    Text="TEMPO / REFERENCIA DEL LENGUAJE"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource PrimaryForegroundBrush}" />

                <TextBlock
                    Text="Documentación y ejemplos de programación TM"
                    FontSize="12"
                    Margin="0,5,0,0"
                    Foreground="{DynamicResource SecondaryForegroundBrush}" />

            </StackPanel>
        </Border>

        <!-- Contenido principal -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navegación lateral -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="12,18">

                <DockPanel>

                    <TextBlock DockPanel.Dock="Top"
                               Text="CONTENIDO"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="12,0,0,12"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" />

                    <ListBox
                        ItemsSource="{Binding Sections}"
                        SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                        ItemContainerStyle="{StaticResource ReferenceNavigationItem}"
                        Background="Transparent"
                        BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding Title}"
                                    FontSize="13"
                                    TextWrapping="Wrap"
                                    Foreground="{DynamicResource PrimaryForegroundBrush}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                </DockPanel>

            </Border>

            <!-- Información de la sección seleccionada -->
            <ScrollViewer
                Grid.Column="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Background="{DynamicResource SurfaceBackgroundBrush}">

                <StackPanel Margin="28,24,28,30">

                    <TextBlock
                        Text="{Binding SelectedSection.Title}"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="{DynamicResource PrimaryForegroundBrush}" />

                    <TextBlock
                        Text="{Binding SelectedSection.Summary}"
                        FontSize="14"
                        TextWrapping="Wrap"
                        Margin="0,12,0,20"
                        Foreground="{DynamicResource SecondaryForegroundBrush}" />

                    <TextBlock
                        Text="DESCRIPCIÓN"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Margin="0,0,0,10"
                        Foreground="{DynamicResource PrimaryForegroundBrush}" />

                    <TextBlock
                        Text="{Binding SelectedSection.Details}"
                        FontSize="13"
                        LineHeight="21"
                        TextWrapping="Wrap"
                        Margin="0,0,0,22"
                        Foreground="{DynamicResource PrimaryForegroundBrush}" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="EJEMPLO EN TEMPO"
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryForegroundBrush}" />

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal">

                            <!-- Copiar el codigo al portapapeles -->
                            <Button
                                Content="Copiar ejemplo"
                                Style="{StaticResource ReferenceButton}"
                                Margin="0,0,8,0"
                                Click="CopyExample_Click" />

                            <!-- Insertar el codigo en el documento activo -->
                            <Button
                                x:Name="InsertExampleButton"
                                Content="Insertar en el editor"
                                Style="{StaticResource ReferenceButton}"
                                Click="InsertExample_Click"
                                ToolTip="Inserta este ejemplo en la posicion del cursor" />
                        </StackPanel>

                    </Grid>

                    <!-- Recuadro de código -->
                    <Border
                        Background="{DynamicResource WindowBackgroundBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16">

                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">

                            <TextBlock
                                Text="{Binding SelectedSection.Example}"
                                FontFamily="Consolas"
                                FontSize="13"
                                LineHeight="22"
                                TextWrapping="NoWrap"
                                Foreground="{DynamicResource PrimaryForegroundBrush}" />

                        </ScrollViewer>

                    </Border>

                    <!-- Nota inferior -->
                    <Border
                        Background="{DynamicResource HoverBackgroundBrush}"
                        CornerRadius="6"
                        Padding="15"
                        Margin="0,18,0,0">

                        <StackPanel>

                            <TextBlock
                                Text="NOTA IMPORTANTE"
                                FontWeight="SemiBold"
                                FontSize="11"
                                Foreground="{DynamicResource PrimaryForegroundBrush}" />

                            <TextBlock
                                Text="{Binding SelectedSection.Note}"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Margin="0,7,0,0"
                                Foreground="{DynamicResource PrimaryForegroundBrush}" />

                        </StackPanel>

                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- Pie de la ventana -->
        <Border
            Grid.Row="2"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="Referencia del lenguaje TM"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource SecondaryForegroundBrush}" />

                <Button
                    Grid.Column="1"
                    Content="Cerrar"
                    IsCancel="True"
                    Width="110"
                    Style="{StaticResource ReferenceButton}" />

            </Grid>

        </Border>

    </Grid>
</Window>
