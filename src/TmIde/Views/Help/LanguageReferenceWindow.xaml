<Window x:Class="TmIde.Views.Help.LanguageReferenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:TmIde.Views.Behaviors"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:shellviews="clr-namespace:TmIde.Views.Shell"
        Title="Tempo - Referencia del lenguaje"
        Width="940"
        Height="640"
        MinWidth="740"
        MinHeight="480"
        ResizeMode="CanResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Item lateral -->
        <Style x:Key="ReferenceNavigationItem"
               TargetType="ListBoxItem">
            <Setter Property="Foreground"
                    Value="{DynamicResource ExplorerItemForegroundBrush}" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Margin"
                    Value="0,0,0,6" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="OuterBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0">

                            <Grid Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="SelectionBar"
                                        Grid.Column="0"
                                        Background="Transparent" />

                                <Border x:Name="ItemBackground"
                                        Grid.Column="1"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        Padding="14,0,12,0">

                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ItemBackground"
                                        Property="Background"
                                        Value="{DynamicResource InactiveTabHoverBackgroundBrush}" />

                                <Setter TargetName="ItemBackground"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ExplorerSplitterBrush}" />
                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="SelectionBar"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceAccentBrush}" />
                                <Setter TargetName="ItemBackground"
                                        Property="Background"
                                        Value="{DynamicResource InactiveTabHoverBackgroundBrush}" />

                                <Setter TargetName="ItemBackground"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ExplorerSplitterBrush}" />
                                <Setter Property="FontWeight"
                                        Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón rectangular -->
        <Style x:Key="ReferenceButton"
            TargetType="Button">
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryForegroundBrush}" />
            <Setter Property="Background"
                    Value="{DynamicResource ReferencePanelBackgroundBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Padding"
                    Value="16,9" />
            <Setter Property="Height"
                    Value="36" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBackground"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />

                            <Border x:Name="HoverLayer"
                                    Background="Transparent"
                                    IsHitTestVisible="False" />

                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="{DynamicResource HoverBackgroundBrush}" />
                                <Setter TargetName="ButtonBackground"
                                        Property="BorderBrush"
                                        Value="{DynamicResource SurfaceAccentBrush}" />
                                <Setter TargetName="HoverLayer"
                                        Property="Background"
                                        Value="#16FFFFFF" />
                            </Trigger>

                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="{DynamicResource HoverBackgroundBrush}" />
                                <Setter TargetName="ButtonBackground"
                                        Property="BorderBrush"
                                        Value="{DynamicResource SurfaceAccentBrush}" />
                                <Setter TargetName="HoverLayer"
                                        Property="Background"
                                        Value="#33000000" />
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tarjeta principal -->
        <Style x:Key="ReferenceCardBorder"
            TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource HoverBackgroundBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Margin"
                    Value="0,0,0,18" />
        </Style>

    </Window.Resources>

    <Border BorderBrush="{StaticResource OverlayEdgeBrush}"
            BorderThickness="1"
            Background="{DynamicResource SurfaceBackgroundBrush}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Barra superior compartida -->
            <Grid Grid.Row="0"
                  Background="Transparent">

                <b:Interaction.Behaviors>
                    <behaviors:WindowDragBehavior
                        MaximizeOnDoubleClick="True" />
                </b:Interaction.Behaviors>

                <shellviews:TitleMenuBarView ShowMenus="False" />
            </Grid>

            <!-- Línea roja -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceAccentBrush}" />

            <!-- Encabezado -->
            <Border Grid.Row="2"
                    Background="{DynamicResource ReferencePanelBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="26,20">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="TEMPO / REFERENCIA DEL LENGUAJE"
                                   FontSize="{DynamicResource FontSizeDisplay}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}" />

                        <TextBlock Text="Documentación y ejemplos de programación TM"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1"
                            Background="{DynamicResource WindowBandBrush}"
                            Padding="12,8">
                        <TextBlock Text="AYUDA DEL LENGUAJE"
                                Foreground="{DynamicResource TitlePlateForegroundBrush}"
                                FontSize="{DynamicResource FontSizeSmall}"
                                FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <!-- Contenido -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Navegación izquierda -->
                <Border Grid.Column="0"
                        Background="{DynamicResource ExplorerBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="14,18">

                    <DockPanel LastChildFill="True">

                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource InactiveTabBackgroundBrush}"
                                BorderBrush="{DynamicResource ExplorerSplitterBrush}"
                                BorderThickness="1"
                                Padding="14,12"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="CONTENIDO"
                                        FontSize="{DynamicResource FontSizeSmall}"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource InactiveTabForegroundBrush}" />

                                <TextBlock Text="Secciones de referencia"
                                        Margin="0,4,0,0"
                                        FontSize="{DynamicResource FontSizeBody}"
                                        Foreground="{DynamicResource ExplorerItemForegroundBrush}" />
                            </StackPanel>
                        </Border>

                        <ListBox ItemsSource="{Binding Sections}"
                                 SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource ReferenceNavigationItem}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}"
                                            FontSize="{DynamicResource FontSizeEmphasis}"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource ExplorerItemForegroundBrush}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Panel derecho -->
                <ScrollViewer Grid.Column="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="{DynamicResource SurfaceBackgroundBrush}">

                    <StackPanel Margin="28,24,28,28">

                        <!-- Título de sección -->
                        <Border Style="{StaticResource ReferenceCardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="{DynamicResource SurfaceAccentBrush}" />

                                <StackPanel Grid.Row="1"
                                            Margin="18,16,18,16">
                                    <TextBlock Text="{Binding SelectedSection.Title}"
                                               FontSize="{DynamicResource FontSizeDisplay}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}" />

                                    <TextBlock Text="{Binding SelectedSection.Summary}"
                                               FontSize="{DynamicResource FontSizeTitle}"
                                               TextWrapping="Wrap"
                                               Margin="0,12,0,0"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Descripción -->
                        <Border Style="{StaticResource ReferenceCardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="{DynamicResource PanelHeaderBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="16,12">
                                    <TextBlock Text="DESCRIPCIÓN"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ExplorerItemForegroundBrush}" />
                                </Border>

                                <TextBlock Grid.Row="1"
                                           Text="{Binding SelectedSection.Details}"
                                           FontSize="{DynamicResource FontSizeEmphasis}"
                                           LineHeight="22"
                                           TextWrapping="Wrap"
                                           Margin="18,16,18,18"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}" />
                            </Grid>
                        </Border>

                        <!-- Ejemplo -->
                        <Border Style="{StaticResource ReferenceCardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0"
                                        Background="{DynamicResource PanelHeaderBrush}"
                                        Margin="0"
                                        VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.ColumnSpan="2"
                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="16,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="EJEMPLO EN TEMPO"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ExplorerItemForegroundBrush}" />

                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal">
                                                <Button Content="Copiar ejemplo"
                                                        Style="{StaticResource ReferenceButton}"
                                                        Margin="0,0,8,0"
                                                        Click="OnCopyExampleClick" />

                                                <Button x:Name="InsertExampleButton"
                                                        Content="Insertar en el editor"
                                                        Style="{StaticResource ReferenceButton}"
                                                        Click="OnInsertExampleClick"
                                                        ToolTip="Inserta este ejemplo en la posicion del cursor" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="1"
                                        Background="{DynamicResource ReferencePanelBackgroundBrush}"
                                        Margin="16"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1"
                                        Padding="14">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <TextBlock Text="{Binding SelectedSection.Example}"
                                                   FontFamily="{DynamicResource CodeFontFamily}"
                                                   FontSize="{DynamicResource FontSizeEmphasis}"
                                                   LineHeight="22"
                                                   TextWrapping="NoWrap"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Nota -->
                        <Border Style="{StaticResource ReferenceCardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="{DynamicResource PanelHeaderBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="16,12">
                                    <TextBlock Text="NOTA IMPORTANTE"
                                               FontWeight="SemiBold"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="{DynamicResource ExplorerItemForegroundBrush}" />
                                </Border>

                                <TextBlock Grid.Row="1"
                                           Text="{Binding SelectedSection.Note}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           TextWrapping="Wrap"
                                           LineHeight="21"
                                           Margin="18,16,18,18"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}" />
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Pie -->
            <Border Grid.Row="4"
                    Background="{DynamicResource ReferencePanelBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Referencia del lenguaje TM"
                               FontSize="{DynamicResource FontSizeBody}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" />

                    <Button Grid.Column="1"
                            Content="Cerrar"
                            IsCancel="True"
                            Width="110"
                            Style="{StaticResource ReferenceButton}"
                            Background="{DynamicResource SurfaceAccentBrush}"
                            Foreground="{DynamicResource SurfaceAccentForegroundBrush}"
                            BorderBrush="{DynamicResource SurfaceAccentBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>