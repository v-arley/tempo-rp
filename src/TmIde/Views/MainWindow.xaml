<Window x:Class="TmIde.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:shellviews="clr-namespace:TmIde.Views.Shell"
        xmlns:explorer="clr-namespace:TmIde.Views.Explorer"
        xmlns:editor="clr-namespace:TmIde.Views.Editor"
        xmlns:panel="clr-namespace:TmIde.Views.Panel"
        xmlns:views="clr-namespace:TmIde.Views"
        xmlns:design="clr-namespace:TmIde.Design"
        mc:Ignorable="d"
        d:DataContext="{x:Static design:DesignData.MainWindow}"
        Title="{Binding Title}"
        Height="680" Width="1080"
        MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Fila 0: header (zona de arrastre) -->
        <Grid Grid.Row="0" Background="Transparent"
                MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <shellviews:TitleMenuBarView DataContext="{Binding}" />
        </Grid>

        <!-- Fila 1: zona central = explorador (izq., altura completa) | editor + terminal (der.) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="170" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- Explorador: ocupa todo el espacio entre header y footer, sin márgenes -->
            <Border Grid.Column="0"
                    Background="{DynamicResource PanelOverlayBrush}">
                <explorer:FileExplorerView DataContext="{Binding Explorer}" />
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                            VerticalAlignment="Stretch" />

            <!-- Sección derecha: editor arriba, terminal abajo -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="200" MinHeight="100" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" ClipToBounds="True"
                        Background="{DynamicResource SurfaceBackgroundBrush}">
                    <editor:EditorHostView DataContext="{Binding EditorHost}" />
                </Border>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceBackgroundBrush}">
                    <panel:BottomPanelView DataContext="{Binding BottomPanel}" />
                </Border>
            </Grid>
        </Grid>

        <!-- Fila 2: footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBackgroundBrush}">
            <views:StatusBarView DataContext="{Binding StatusBar}" />
        </Border>
    </Grid>
</Window>
