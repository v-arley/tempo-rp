<UserControl x:Class="TmIde.Views.Explorer.FileExplorerView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:conv="clr-namespace:TmIde.Converters"
            xmlns:design="clr-namespace:TmIde.Design"
            mc:Ignorable="d"
            d:DataContext="{x:Static design:DesignData.Explorer}"
            d:DesignWidth="260" d:DesignHeight="500">

    <UserControl.Resources>
        <conv:ResourceKeyToGeometryConverter x:Key="KeyToGeometry" />

        <!-- Botón de icono de la cabecera (nuevo archivo / nueva carpeta) -->
        <Style x:Key="ExplorerHeaderIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caja de búsqueda: fondo oscuro en ambos temas, por lo que su texto y
            su cursor usan un gris claro fijo. Realce de foco discreto. -->
        <Style x:Key="ExplorerSearchBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#C7CBD2" />
            <Setter Property="CaretBrush" Value="#C7CBD2" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="Padding" Value="26,4,8,4" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Fondo del panel (área del árbol) -->
    <Border Background="{DynamicResource PanelOverlayBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Cabecera: título, acciones y búsqueda -->
            <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBrush}" Padding="10,6"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <!-- Título + acciones -->
                    <Grid>
                        <TextBlock Text="{Binding HeaderTitle}"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold"
                                    Foreground="{DynamicResource PrimaryForegroundBrush}" />
                        <!-- Acciones del explorador -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <Button
                                Style="{StaticResource ExplorerHeaderIconButton}"
                                ToolTip="Nuevo archivo"
                                Command="{Binding CreateFileCommand}">

                                <Path
                                    Style="{StaticResource IconPath}"
                                    Width="13"
                                    Height="13"
                                    Data="{StaticResource IconFile}"
                                    Fill="{DynamicResource PrimaryForegroundBrush}" />
                            </Button>

                            <Button
                                Style="{StaticResource ExplorerHeaderIconButton}"
                                ToolTip="Nueva carpeta"
                                Command="{Binding CreateFolderCommand}">

                                <Path
                                    Style="{StaticResource IconPath}"
                                    Width="13"
                                    Height="13"
                                    Data="{StaticResource IconFolder}"
                                    Fill="{DynamicResource PrimaryForegroundBrush}" />
                            </Button>

                        </StackPanel>
                    </Grid>

                    <!-- Búsqueda -->
                    <Grid Margin="0,6,0,0">
                        <TextBox Style="{StaticResource ExplorerSearchBox}"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <!-- Lupa y placeholder sobre el campo oscuro: gris claro fijo -->
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSearch}"
                                Width="12" Height="12" Margin="8,0,0,0"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Fill="#8A8F9B" IsHitTestVisible="False" />
                        <TextBlock Text="SEARCH FILE" Margin="26,0,0,0"
                                    VerticalAlignment="Center" IsHitTestVisible="False"
                                    Foreground="#8A8F9B" FontSize="{DynamicResource FontSizeSmall}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Árbol de archivos del proyecto -->
            <TreeView   Grid.Row="1"
                        ItemsSource="{Binding Roots}"
                        SelectedItemChanged="Tree_SelectedItemChanged"
                        PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                        PreviewKeyDown="Tree_PreviewKeyDown"
                        BorderThickness="0"
                        Background="Transparent"
                        Padding="8,10">

                <TreeView.ItemContainerStyle>
                    <Style TargetType="{x:Type TreeViewItem}">

                        <Setter Property="IsExpanded"
                                Value="{Binding IsExpanded, Mode=TwoWay}" />

                        <Setter Property="IsSelected"
                                Value="{Binding IsSelected, Mode=TwoWay}" />

                        <Setter Property="Tag"
                                Value="{Binding DataContext,
                                    RelativeSource={RelativeSource AncestorType=TreeView}}" />

                        <Setter Property="ContextMenu">
                            <Setter.Value>

                                <ContextMenu
                                    Background="{DynamicResource SurfaceBackgroundBrush}"
                                    Foreground="{DynamicResource PrimaryForegroundBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1"
                                    Padding="4"
                                    MinWidth="190">

                                    <ContextMenu.Template>
                                        <ControlTemplate TargetType="{x:Type ContextMenu}">

                                            <Border
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">

                                                <ItemsPresenter
                                                    KeyboardNavigation.DirectionalNavigation="Cycle" />

                                            </Border>

                                        </ControlTemplate>
                                    </ContextMenu.Template>

                                    <!-- Estilos exclusivos de este menú -->
                                    <ContextMenu.Resources>

                                        <Style TargetType="{x:Type MenuItem}">

                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource PrimaryForegroundBrush}" />

                                            <Setter Property="Background"
                                                    Value="Transparent" />

                                            <Setter Property="Padding"
                                                    Value="12,9" />

                                            <Setter Property="MinHeight"
                                                    Value="34" />

                                            <Setter Property="Cursor"
                                                    Value="Hand" />

                                            <Setter Property="Template">
                                                <Setter.Value>

                                                    <ControlTemplate TargetType="{x:Type MenuItem}">

                                                        <Border
                                                            x:Name="ItemBackground"
                                                            Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}">

                                                            <Grid>

                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Nombre de la opción -->
                                                                <TextBlock
                                                                    Grid.Column="0"
                                                                    Text="{TemplateBinding Header}"
                                                                    Foreground="{TemplateBinding Foreground}"
                                                                    FontSize="{DynamicResource FontSizeBody}"
                                                                    VerticalAlignment="Center" />

                                                                <!-- Atajo de teclado -->
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Text="{TemplateBinding InputGestureText}"
                                                                    Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                    FontSize="{DynamicResource FontSizeSmall}"
                                                                    Margin="20,0,0,0"
                                                                    VerticalAlignment="Center" />

                                                            </Grid>

                                                        </Border>

                                                        <ControlTemplate.Triggers>

                                                            <!-- Resaltado al pasar el cursor -->
                                                            <Trigger Property="IsHighlighted"
                                                                    Value="True">

                                                                <Setter
                                                                    TargetName="ItemBackground"
                                                                    Property="Background"
                                                                    Value="{DynamicResource HoverBackgroundBrush}" />

                                                            </Trigger>

                                                            <!-- Opciones deshabilitadas -->
                                                            <Trigger Property="IsEnabled"
                                                                    Value="False">

                                                                <Setter Property="Opacity"
                                                                        Value="0.4" />

                                                            </Trigger>

                                                        </ControlTemplate.Triggers>

                                                    </ControlTemplate>

                                                </Setter.Value>
                                            </Setter>

                                        </Style>

                                        <!-- Separador del menú -->
                                        <Style TargetType="{x:Type Separator}">

                                            <Setter Property="Template">
                                                <Setter.Value>

                                                    <ControlTemplate TargetType="{x:Type Separator}">

                                                        <Border
                                                            Height="1"
                                                            Margin="8,5"
                                                            Background="{DynamicResource DividerBrush}" />

                                                    </ControlTemplate>

                                                </Setter.Value>
                                            </Setter>

                                        </Style>

                                    </ContextMenu.Resources>

                                    <!-- Opciones del menú -->

                                    <MenuItem
                                        Header="Nuevo archivo"
                                        Command="{Binding PlacementTarget.Tag.CreateFileCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                    <MenuItem
                                        Header="Nueva carpeta"
                                        Command="{Binding PlacementTarget.Tag.CreateFolderCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                    <Separator />

                                    <MenuItem
                                        Header="Renombrar"
                                        InputGestureText="F2"
                                        Command="{Binding PlacementTarget.Tag.RenameSelectedCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                    <MenuItem
                                        Header="Eliminar"
                                        InputGestureText="Supr"
                                        Command="{Binding PlacementTarget.Tag.DeleteSelectedCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                </ContextMenu>

                            </Setter.Value>
                        </Setter>

                    </Style>
                </TreeView.ItemContainerStyle>
                
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <Grid Background="Transparent">
                            <Grid.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenCommand}" />
                            </Grid.InputBindings>
                            <StackPanel Orientation="Horizontal">

                                <!-- Icono del archivo o carpeta -->
                                <Path
                                    Width="13"
                                    Height="13"
                                    VerticalAlignment="Center"
                                    Data="{Binding IconKey,
                                        Converter={StaticResource KeyToGeometry}}">

                                    <Path.Style>
                                        <Style
                                            TargetType="Path"
                                            BasedOn="{StaticResource IconPath}">

                                            <Setter
                                                Property="Fill"
                                                Value="{DynamicResource PrimaryForegroundBrush}" />

                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsMainProjectFile}"
                                                    Value="True">

                                                    <Setter
                                                        Property="Fill"
                                                        Value="#7EC8E3" />

                                                </DataTrigger>
                                            </Style.Triggers>

                                        </Style>
                                    </Path.Style>

                                </Path>

                                <!-- Nombre del archivo -->
                                <TextBlock
                                    Text="{Binding Name}"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource FontSizeBody}">

                                    <TextBlock.Style>
                                        <Style
                                            TargetType="TextBlock"
                                            BasedOn="{StaticResource {x:Type TextBlock}}">

                                            <Setter
                                                Property="Foreground"
                                                Value="{DynamicResource PrimaryForegroundBrush}" />

                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsMainProjectFile}"
                                                    Value="True">

                                                    <Setter
                                                        Property="FontWeight"
                                                        Value="SemiBold" />

                                                    <Setter
                                                        Property="Foreground"
                                                        Value="#7EC8E3" />

                                                </DataTrigger>
                                            </Style.Triggers>

                                        </Style>
                                    </TextBlock.Style>

                                </TextBlock>

                                <!-- Etiqueta exclusiva de los archivos .tmpr -->
                                <TextBlock
                                    Text="PRINCIPAL"
                                    Margin="9,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource FontSizeCaption}"
                                    FontWeight="SemiBold"
                                    Foreground="#7EC8E3"
                                    Visibility="{Binding IsMainProjectFile,
                                                Converter={StaticResource BoolToVisibility}}" />

                            </StackPanel>
                        </Grid>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>
    </Border>
</UserControl>
