<UserControl x:Class="TmIde.Views.Explorer.FileExplorerView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:conv="clr-namespace:TmIde.Converters"
            xmlns:design="clr-namespace:TmIde.Design"
            mc:Ignorable="d"
            d:DataContext="{x:Static design:DesignData.Explorer}"
            d:DesignWidth="260" d:DesignHeight="500">

    <UserControl.Resources>
        <conv:ResourceKeyToGeometryConverter x:Key="KeyToGeometry" />

        <!-- Selección: azul con texto blanco en ambos temas. El texto en reposo
            (ExplorerItemForegroundBrush, ExplorerMainFileForegroundBrush) sale del tema. -->
        <SolidColorBrush x:Key="ExplorerItemSelectedForegroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ExplorerItemSelectedBackgroundBrush" Color="#2B84D6" />
        <SolidColorBrush x:Key="ExplorerMainFileSelectedForegroundBrush" Color="#F4FCFF" />
        <!-- Acento de la cabecera: título y acciones (nuevo archivo / nueva carpeta) -->
        <SolidColorBrush x:Key="ExplorerHeaderAccentBrush" Color="#BF3B2C" />

        <Style x:Key="ExplorerTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- Botón de icono de la cabecera (nuevo archivo / nueva carpeta) -->
        <Style x:Key="ExplorerHeaderIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Fondo del panel (área del árbol) -->
    <Border Background="{DynamicResource ExplorerBackgroundBrush}"
            BorderBrush="{DynamicResource ExplorerSplitterBrush}" BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Cabecera: título y acciones -->
            <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBrush}" Padding="10,6">
                <StackPanel>
                    <!-- Título + acciones -->
                    <Grid>
                        <TextBlock Text="{Binding HeaderTitle}"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold"
                                    Foreground="{StaticResource ExplorerHeaderAccentBrush}" />
                        <!-- Acciones del explorador -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <Button
                                Style="{StaticResource ExplorerHeaderIconButton}"
                                ToolTip="Nuevo archivo"
                                Command="{Binding CreateFileCommand}">

                                <Path
                                    Style="{StaticResource IconPath}"
                                    Width="13"
                                    Height="13"
                                    Data="{StaticResource IconFile}"
                                    Fill="{StaticResource ExplorerHeaderAccentBrush}" />
                            </Button>

                            <Button
                                Style="{StaticResource ExplorerHeaderIconButton}"
                                ToolTip="Nueva carpeta"
                                Command="{Binding CreateFolderCommand}">

                                <Path
                                    Style="{StaticResource IconPath}"
                                    Width="13"
                                    Height="13"
                                    Data="{StaticResource IconFolder}"
                                    Fill="{StaticResource ExplorerHeaderAccentBrush}" />
                            </Button>

                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Árbol de archivos del proyecto -->
            <TreeView   Grid.Row="1"
                        ItemsSource="{Binding Roots}"
                        SelectedItemChanged="OnTreeSelectedItemChanged"
                        PreviewMouseRightButtonDown="OnTreePreviewMouseRightButtonDown"
                        PreviewKeyDown="OnTreePreviewKeyDown"
                        BorderThickness="0"
                        Background="Transparent"
                        Padding="8,10">

                <TreeView.ItemContainerStyle>
                    <Style TargetType="{x:Type TreeViewItem}">

                        <Setter Property="FocusVisualStyle"
                                Value="{x:Null}" />

                        <Setter Property="IsExpanded"
                                Value="{Binding IsExpanded, Mode=TwoWay}" />

                        <Setter Property="IsSelected"
                                Value="{Binding IsSelected, Mode=TwoWay}" />

                        <Setter Property="Tag"
                                Value="{Binding DataContext,
                                    RelativeSource={RelativeSource AncestorType=TreeView}}" />

                        <Setter Property="ContextMenu">
                            <Setter.Value>

                                <ContextMenu
                                    Background="{DynamicResource SurfaceBackgroundBrush}"
                                    Foreground="{DynamicResource PrimaryForegroundBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1"
                                    Padding="4"
                                    MinWidth="190">

                                    <ContextMenu.Template>
                                        <ControlTemplate TargetType="{x:Type ContextMenu}">

                                            <Border
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">

                                                <ItemsPresenter
                                                    KeyboardNavigation.DirectionalNavigation="Cycle" />

                                            </Border>

                                        </ControlTemplate>
                                    </ContextMenu.Template>

                                    <!-- Estilos exclusivos de este menú -->
                                    <ContextMenu.Resources>

                                        <Style TargetType="{x:Type MenuItem}">

                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource PrimaryForegroundBrush}" />

                                            <Setter Property="Background"
                                                    Value="Transparent" />

                                            <Setter Property="Padding"
                                                    Value="12,9" />

                                            <Setter Property="MinHeight"
                                                    Value="34" />

                                            <Setter Property="Cursor"
                                                    Value="Hand" />

                                            <Setter Property="Template">
                                                <Setter.Value>

                                                    <ControlTemplate TargetType="{x:Type MenuItem}">

                                                        <Border
                                                            x:Name="ItemBackground"
                                                            Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}">

                                                            <Grid>

                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Nombre de la opción -->
                                                                <TextBlock
                                                                    Grid.Column="0"
                                                                    Text="{TemplateBinding Header}"
                                                                    Foreground="{TemplateBinding Foreground}"
                                                                    FontSize="{DynamicResource FontSizeBody}"
                                                                    VerticalAlignment="Center" />

                                                                <!-- Atajo de teclado -->
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Text="{TemplateBinding InputGestureText}"
                                                                    Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                    FontSize="{DynamicResource FontSizeSmall}"
                                                                    Margin="20,0,0,0"
                                                                    VerticalAlignment="Center" />

                                                            </Grid>

                                                        </Border>

                                                        <ControlTemplate.Triggers>

                                                            <!-- Resaltado al pasar el cursor -->
                                                            <Trigger Property="IsHighlighted"
                                                                    Value="True">

                                                                <Setter
                                                                    TargetName="ItemBackground"
                                                                    Property="Background"
                                                                    Value="{DynamicResource HoverBackgroundBrush}" />

                                                            </Trigger>

                                                            <!-- Opciones deshabilitadas -->
                                                            <Trigger Property="IsEnabled"
                                                                    Value="False">

                                                                <Setter Property="Opacity"
                                                                        Value="0.4" />

                                                            </Trigger>

                                                        </ControlTemplate.Triggers>

                                                    </ControlTemplate>

                                                </Setter.Value>
                                            </Setter>

                                        </Style>

                                        <!-- Separador del menú -->
                                        <Style TargetType="{x:Type Separator}">

                                            <Setter Property="Template">
                                                <Setter.Value>

                                                    <ControlTemplate TargetType="{x:Type Separator}">

                                                        <Border
                                                            Height="1"
                                                            Margin="8,5"
                                                            Background="{DynamicResource DividerBrush}" />

                                                    </ControlTemplate>

                                                </Setter.Value>
                                            </Setter>

                                        </Style>

                                    </ContextMenu.Resources>

                                    <!-- Opciones del menú -->

                                    <MenuItem
                                        Header="Nuevo archivo"
                                        Command="{Binding PlacementTarget.Tag.CreateFileCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                    <MenuItem
                                        Header="Nueva carpeta"
                                        Command="{Binding PlacementTarget.Tag.CreateFolderCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                    <Separator />

                                    <MenuItem
                                        Header="Renombrar"
                                        InputGestureText="F2"
                                        Command="{Binding PlacementTarget.Tag.RenameSelectedCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                    <MenuItem
                                        Header="Eliminar"
                                        InputGestureText="Supr"
                                        Command="{Binding PlacementTarget.Tag.DeleteSelectedCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                </ContextMenu>

                            </Setter.Value>
                        </Setter>

                    </Style>
                </TreeView.ItemContainerStyle>
                
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <Grid Background="Transparent">
                            <Grid.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenCommand}" />
                            </Grid.InputBindings>

                            <Border
                                Padding="4,2"
                                Margin="0,1,0,1"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">

                                <Border.Style>
                                    <Style TargetType="Border">

                                        <Setter
                                            Property="Background"
                                            Value="Transparent" />

                                        <Style.Triggers>

                                            <!-- Selección visible aunque el TreeView pierda foco -->
                                            <DataTrigger
                                                Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem},
                                                                Path=IsSelected}"
                                                Value="True">

                                                <Setter
                                                    Property="Background"
                                                    Value="{StaticResource ExplorerItemSelectedBackgroundBrush}" />

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>
                                </Border.Style>

                                <StackPanel Orientation="Horizontal">

                                    <!-- Icono del archivo o carpeta -->
                                    <Path
                                        Width="13"
                                        Height="13"
                                        VerticalAlignment="Center"
                                        Data="{Binding IconKey,
                                            Converter={StaticResource KeyToGeometry}}">

                                        <Path.Style>
                                            <Style
                                                TargetType="Path"
                                                BasedOn="{StaticResource IconPath}">

                                                <Setter
                                                    Property="Fill"
                                                    Value="{DynamicResource ExplorerItemForegroundBrush}" />

                                                <Style.Triggers>

                                                    <!-- principal.tmpr -->
                                                    <DataTrigger
                                                        Binding="{Binding IsMainProjectFile}"
                                                        Value="True">

                                                        <Setter
                                                            Property="Fill"
                                                             Value="{DynamicResource ExplorerMainFileForegroundBrush}" />

                                                    </DataTrigger>

                                                    <!-- item seleccionado -->
                                                    <DataTrigger
                                                        Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem},
                                                                        Path=IsSelected}"
                                                        Value="True">

                                                        <Setter
                                                            Property="Fill"
                                                            Value="{StaticResource ExplorerItemSelectedForegroundBrush}" />

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>
                                        </Path.Style>

                                    </Path>

                                    <!-- Nombre del archivo -->
                                    <TextBlock
                                        Text="{Binding Name}"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12">

                                        <TextBlock.Style>
                                            <Style
                                                TargetType="TextBlock"
                                                BasedOn="{StaticResource {x:Type TextBlock}}">

                                                <Setter
                                                    Property="Foreground"
                                                    Value="{DynamicResource ExplorerItemForegroundBrush}" />

                                                <Style.Triggers>

                                                    <!-- principal.tmpr -->
                                                    <DataTrigger
                                                        Binding="{Binding IsMainProjectFile}"
                                                        Value="True">

                                                        <Setter
                                                            Property="FontWeight"
                                                            Value="SemiBold" />

                                                        <Setter
                                                            Property="Foreground"
                                                            Value="{DynamicResource ExplorerMainFileForegroundBrush}" />

                                                    </DataTrigger>

                                                    <!-- item seleccionado -->
                                                    <DataTrigger
                                                        Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem},
                                                                        Path=IsSelected}"
                                                        Value="True">

                                                        <Setter
                                                            Property="Foreground"
                                                            Value="{StaticResource ExplorerItemSelectedForegroundBrush}" />

                                                        <Setter
                                                            Property="FontWeight"
                                                            Value="SemiBold" />

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>
                                        </TextBlock.Style>

                                    </TextBlock>

                                    <!-- Etiqueta del archivo principal -->
                                    <TextBlock
                                        Text="PRINCIPAL"
                                        Margin="9,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="9"
                                        FontWeight="SemiBold"
                                        Visibility="{Binding IsMainProjectFile,
                                                    Converter={StaticResource BoolToVisibility}}">

                                        <TextBlock.Style>
                                            <Style
                                                TargetType="TextBlock"
                                                BasedOn="{StaticResource {x:Type TextBlock}}">

                                                <Setter
                                                    Property="Foreground"
                                                    Value="{DynamicResource ExplorerMainFileForegroundBrush}" />

                                                <Style.Triggers>

                                                    <!-- principal seleccionado -->
                                                    <DataTrigger
                                                        Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem},
                                                                        Path=IsSelected}"
                                                        Value="True">

                                                        <Setter
                                                            Property="Foreground"
                                                            Value="{StaticResource ExplorerMainFileSelectedForegroundBrush}" />

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>
                                        </TextBlock.Style>

                                    </TextBlock>

                                </StackPanel>

                            </Border>
                        </Grid>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>
    </Border>
</UserControl>
