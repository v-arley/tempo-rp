<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>TmIde</RootNamespace>
    <AssemblyName>TmIde</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Assets\Tempo.ico</ApplicationIcon>
    <!-- La mayoría de propiedades comunes (Nullable, LangVersion, analizadores,
         TreatWarningsAsErrors, CPM) vienen de ../../Directory.Build.props -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <!-- Configuración de la app (sección "Ide" → IdeOptions); el Host la lee
        junto al ejecutable. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\Assets\IBMPlexMono-Thin.ttf" Link="Assets\IBMPlexMono-Thin.ttf" />
    <Resource Include="..\Assets\IBMPlexMono-Light.ttf" Link="Assets\IBMPlexMono-Light.ttf" />
    <Resource Include="..\Assets\IBMPlexMono-Medium.ttf" Link="Assets\IBMPlexMono-Medium.ttf" />
    <Resource Include="..\Assets\IBMPlexMono-Bold.ttf" Link="Assets\IBMPlexMono-Bold.ttf" />
  </ItemGroup>

  <!-- Pipeline del compilador (Lexer, Parser, analizador semántico) para los
      diagnósticos del editor. -->
  <ItemGroup>
    <ProjectReference Include="..\Tempo.Language\Tempo.Language.csproj" />
  </ItemGroup>

</Project>
