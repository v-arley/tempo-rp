<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>TmIde</RootNamespace>
    <AssemblyName>TmIde</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- La mayoría de propiedades comunes (Nullable, LangVersion, analizadores,
         TreatWarningsAsErrors, CPM) vienen de ../../Directory.Build.props -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fuentes monoespaciadas compartidas en src/Assets/ (origen único).
         Se embeben en TmIde como recurso; se referencian en XAML como
         "./Assets/#<nombre interno de la familia>". -->
    <Resource Include="..\Assets\JetBrainsMono-Medium.ttf" Link="Assets\JetBrainsMono-Medium.ttf" />
    <Resource Include="..\Assets\IBMPlexMono-Medium.ttf" Link="Assets\IBMPlexMono-Medium.ttf" />
  </ItemGroup>

  <!-- ProjectReference a TmCompiler.* : se añadirá cuando el IDE cablee el Lexer.
       Esta iteración es solo el esqueleto visual. -->

</Project>
