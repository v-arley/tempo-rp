<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>TmIde</RootNamespace>
    <AssemblyName>TmIde</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- La mayoría de propiedades comunes (Nullable, LangVersion, analizadores,
         TreatWarningsAsErrors, CPM) vienen de ../../Directory.Build.props -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\Assets\JetBrainsMono-Medium.ttf" Link="Assets\JetBrainsMono-Medium.ttf" />
    <Resource Include="..\Assets\IBMPlexMono-Medium.ttf" Link="Assets\IBMPlexMono-Medium.ttf" />
  </ItemGroup>

  <!-- Pipeline del compilador (Lexer, Parser, analizador semántico) para los
       diagnósticos del editor. Infrastructure no se referencia: el IDE da su
       propio formato a los diagnósticos. -->
  <ItemGroup>
    <ProjectReference Include="..\TmCompiler\TmCompiler.Application\TmCompiler.Application.csproj" />
    <ProjectReference Include="..\TmCompiler\TmCompiler.Domain\TmCompiler.Domain.csproj" />
  </ItemGroup>

</Project>
